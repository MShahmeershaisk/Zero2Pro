<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Admin Dashboard - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="container mx-auto max-w-5xl px-6 py-10 flex-1">
    <h2 class="text-3xl font-bold mb-2">Admin Dashboard</h2>
    <p class="text-gray-400 mb-8">Manage users, tutorials, blog posts, and messages.</p>

    <% if (message) { %>
      <p class="mb-6 text-sm bg-green-500/10 border border-green-500/50 text-green-400 rounded-lg py-2 px-4"><%= message %></p>
    <% } %>
    <% if (error) { %>
      <p class="mb-6 text-sm bg-red-500/10 border border-red-500/50 text-red-400 rounded-lg py-2 px-4"><%= error %></p>
    <% } %>

    <!-- User Messages -->
    <section class="mb-10">
      <h3 class="text-xl font-semibold mb-4 flex items-center gap-2">
        Messages
        <% const pendingCount = messages.filter(m => m.status === 'pending').length; %>
        <% if (pendingCount > 0) { %>
          <span class="bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full"><%= pendingCount %></span>
        <% } %>
      </h3>
      <div class="space-y-3">
        <% messages.forEach(m => { %>
          <div class="bg-gray-800 border border-gray-700 rounded-xl p-4">
            <!-- Header: status + subject + date -->
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class="inline-block text-xs px-2 py-0.5 rounded-full
                <%= m.status === 'pending' ? 'bg-yellow-500/20 text-yellow-300' :
                     m.status === 'read' ? 'bg-blue-500/20 text-blue-300' :
                     'bg-green-500/20 text-green-300' %>">
                <%= m.status %>
              </span>
              <span class="text-xs text-gray-500"><%= m.subject %></span>
              <span class="text-xs text-gray-600">•</span>
              <span class="text-xs text-gray-500"><%= m.createdAt ? new Date(m.createdAt).toLocaleDateString() : '—' %></span>
            </div>

            <!-- User info + original message -->
            <p class="text-sm text-gray-300"><strong><%= m.name %></strong> &lt;<%= m.email %>&gt;
              <% if (m.memberId) { %> · ID: <%= m.memberId.slice(0, 8) %><% } %>
            </p>
            <p class="text-sm text-gray-400 mt-1 whitespace-pre-line"><%= m.message %></p>

            <!-- Conversation replies -->
            <% if (m.replies && m.replies.length > 0) { %>
              <div class="mt-3 space-y-2 border-l-2 border-gray-600 pl-3">
                <% m.replies.forEach(r => { %>
                  <div class="<%= r.sender === 'admin' ? 'bg-indigo-500/10 border border-indigo-500/20' : 'bg-gray-700/50 border border-gray-600' %> rounded-lg p-2.5">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-[10px] font-bold <%= r.sender === 'admin' ? 'text-indigo-400' : 'text-teal-400' %>">
                        <%= r.sender === 'admin' ? 'Admin' : r.senderName || 'User' %>
                      </span>
                      <span class="text-[10px] text-gray-500"><%= r.createdAt ? new Date(r.createdAt).toLocaleString() : '' %></span>
                    </div>
                    <p class="text-xs text-gray-300 whitespace-pre-line"><%= r.message %></p>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <!-- Status + Reply + Delete controls -->
            <div class="mt-3 flex flex-wrap gap-2 items-start">
              <!-- Status update form -->
              <form method="POST" action="/admin/message/<%= m._id %>/update" class="flex gap-1 items-center">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <select name="status" class="bg-gray-700 border border-gray-600 rounded px-2 py-1 text-xs text-white">
                  <option value="pending" <%= m.status === 'pending' ? 'selected' : '' %>>Pending</option>
                  <option value="read" <%= m.status === 'read' ? 'selected' : '' %>>Read</option>
                  <option value="resolved" <%= m.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                </select>
                <input name="adminNote" placeholder="Note..." value="<%= m.adminNote || '' %>"
                  class="bg-gray-700 border border-gray-600 rounded px-2 py-1 text-xs text-white w-28 placeholder-gray-500" />
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-2 py-1 rounded text-xs transition">Save</button>
              </form>

              <!-- Inline reply form -->
              <div class="flex-1 min-w-[200px]">
                <form onsubmit="adminReply(event, '<%= m._id %>')" class="flex gap-1 items-center">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="text" id="adminReplyInput-<%= m._id %>" placeholder="Type a reply..."
                    class="flex-1 bg-gray-700 border border-gray-600 rounded px-2 py-1 text-xs text-white placeholder-gray-500" />
                  <button id="adminReplyBtn-<%= m._id %>" type="submit" class="bg-green-600 hover:bg-green-700 text-white px-2 py-1 rounded text-xs transition">Reply</button>
                </form>
              </div>

              <!-- Delete -->
              <form method="POST" action="/admin/message/<%= m._id %>/delete" onsubmit="return confirm('Delete this message?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-2 py-1 rounded text-xs transition">Del</button>
              </form>
            </div>
          </div>
        <% }) %>
        <% if (messages.length === 0) { %>
          <p class="text-gray-400">No messages yet.</p>
        <% } %>
      </div>
    </section>

    <script>
      async function adminReply(e, msgId) {
        e.preventDefault();
        const input = document.getElementById('adminReplyInput-' + msgId);
        const message = input.value.trim();
        if (!message) return;

        const btn = document.getElementById('adminReplyBtn-' + msgId);
        btn.disabled = true;
        const origText = btn.textContent;
        btn.textContent = 'Sending...';

        const csrfToken = document.querySelector('input[name="_csrf"]').value;

        try {
          const res = await fetch('/admin/message/' + msgId + '/reply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ message }),
          });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Failed to send reply.');
          }
        } catch (err) {
          alert('Something went wrong.');
        } finally {
          btn.disabled = false;
          btn.textContent = origText;
        }
      }
    </script>

    <!-- Users -->
    <section class="mb-10">
      <h3 class="text-xl font-semibold mb-4">Users (<%= users.length %>)</h3>
      <div class="bg-gray-800 border border-gray-700 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-700 text-left text-gray-300">
              <tr>
                <th class="px-4 py-3">Name</th>
                <th class="px-4 py-3">Email</th>
                <th class="px-4 py-3">Password</th>
                <th class="px-4 py-3">Role</th>
                <th class="px-4 py-3">Joined</th>
                <th class="px-4 py-3">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
              <% users.forEach(u => { %>
                <tr id="userRow-<%= u._id %>">
                  <td class="px-4 py-3" id="nameCell-<%= u._id %>"><%= u.name %></td>
                  <td class="px-4 py-3 text-gray-400" id="emailCell-<%= u._id %>"><%= u.email %></td>
                  <td class="px-4 py-3 text-gray-500 text-xs" id="pwCell-<%= u._id %>">
                    <% if (u.password) { %>••••••••<% } else { %>Google Auth<% } %>
                  </td>
                  <td class="px-4 py-3">
                    <% if (u.role === 'admin') { %>
                      <span class="inline-block text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full">Admin</span>
                    <% } else { %>
                      <span class="inline-block text-xs bg-gray-600/30 text-gray-300 px-2 py-0.5 rounded-full">User</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-gray-400"><%= u.createdAt ? new Date(u.createdAt).toLocaleDateString() : '—' %></td>
                  <td class="px-4 py-3">
                    <% if (String(u._id) !== String(user.id)) { %>
                      <div class="flex gap-1.5 flex-wrap">
                        <!-- Edit button -->
                        <button onclick="showEditForm('<%= u._id %>', '<%= u.name.replace(/'/g, "\\'") %>', '<%= u.email %>')"
                          class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-2.5 py-1.5 rounded-lg text-xs transition">Edit</button>
                        <!-- Password Reset button -->
                        <button onclick="showPasswordForm('<%= u._id %>', '<%= u.name.replace(/'/g, "\\'") %>')"
                          class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-2.5 py-1.5 rounded-lg text-xs transition">Password</button>
                        <!-- Promote/Demote -->
                        <form method="POST" action="/admin/user/<%= u._id %>/role" class="inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit"
                            class="bg-gray-700 hover:bg-gray-600 text-white font-semibold px-2.5 py-1.5 rounded-lg text-xs transition">
                            <%= u.role === 'admin' ? 'Demote' : 'Promote' %>
                          </button>
                        </form>
                        <!-- Delete -->
                        <form method="POST" action="/admin/user/<%= u._id %>/delete" class="inline"
                          onsubmit="return confirm('Delete user <%= u.name.replace(/'/g, "").replace(/"/g, "") %>? This cannot be undone.')">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit"
                            class="bg-red-600 hover:bg-red-700 text-white font-semibold px-2.5 py-1.5 rounded-lg text-xs transition">Delete</button>
                        </form>
                      </div>
                    <% } else { %>
                      <span class="text-gray-500 text-xs">(you)</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Edit User Modal -->
    <div id="editUserModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
      <div class="bg-gray-800 border border-gray-700 rounded-2xl shadow-xl w-full max-w-md p-6">
        <h3 class="text-lg font-bold mb-4">Edit User</h3>
        <form id="editUserForm" onsubmit="submitEditUser(event)">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" id="editUserId" value="" />
          <div class="space-y-3">
            <div>
              <label class="block text-sm text-gray-300 mb-1">Name</label>
              <input type="text" id="editName" required
                class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div>
              <label class="block text-sm text-gray-300 mb-1">Email</label>
              <input type="email" id="editEmail" required
                class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
          </div>
          <div class="flex gap-2 mt-5">
            <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg text-sm transition">Save Changes</button>
            <button type="button" onclick="closeEditModal()" class="px-4 py-2.5 bg-gray-700 hover:bg-gray-600 text-gray-300 rounded-lg text-sm transition">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Reset Password Modal -->
    <div id="resetPwModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
      <div class="bg-gray-800 border border-gray-700 rounded-2xl shadow-xl w-full max-w-md p-6">
        <h3 class="text-lg font-bold mb-1">Reset Password</h3>
        <p class="text-gray-400 text-sm mb-4">Set new password for <strong id="resetPwUserName"></strong></p>
        <form id="resetPwForm" onsubmit="submitResetPassword(event)">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" id="resetPwUserId" value="" />
          <div class="space-y-3">
            <div>
              <label class="block text-sm text-gray-300 mb-1">New Password</label>
              <input type="password" id="newPassword" required minlength="8"
                placeholder="At least 8 characters, 1 uppercase, 1 number"
                class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
              <p class="text-xs text-gray-500 mt-1">Password: at least 8 characters with 1 uppercase letter and 1 number</p>
            </div>
            <div>
              <label class="block text-sm text-gray-300 mb-1">Confirm Password</label>
              <input type="password" id="confirmPassword" required minlength="8"
                placeholder="Re-enter password"
                class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
          </div>
          <div class="flex gap-2 mt-5">
            <button type="submit" class="flex-1 bg-amber-600 hover:bg-amber-700 text-white font-semibold py-2.5 rounded-lg text-sm transition">Reset Password</button>
            <button type="button" onclick="closeResetPwModal()" class="px-4 py-2.5 bg-gray-700 hover:bg-gray-600 text-gray-300 rounded-lg text-sm transition">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      // ===== Edit User Modal =====
      function showEditForm(id, name, email) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editEmail').value = email;
        document.getElementById('editUserModal').classList.remove('hidden');
      }
      function closeEditModal() {
        document.getElementById('editUserModal').classList.add('hidden');
      }
      async function submitEditUser(e) {
        e.preventDefault();
        const id = document.getElementById('editUserId').value;
        const name = document.getElementById('editName').value.trim();
        const email = document.getElementById('editEmail').value.trim();
        const csrfToken = document.querySelector('#editUserForm input[name="_csrf"]').value;
        if (!name || !email) return alert('Name and Email are required.');

        const btn = e.target.querySelector('button[type="submit"]');
        btn.disabled = true;
        const origText = btn.textContent;
        btn.textContent = 'Saving...';

        try {
          const res = await fetch('/admin/user/' + id + '/edit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ name, email }),
          });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Failed to update user.');
          }
        } catch (err) {
          alert('Something went wrong.');
        } finally {
          btn.disabled = false;
          btn.textContent = origText;
        }
      }

      // ===== Reset Password Modal =====
      function showPasswordForm(id, name) {
        document.getElementById('resetPwUserId').value = id;
        document.getElementById('resetPwUserName').textContent = name;
        document.getElementById('newPassword').value = '';
        document.getElementById('confirmPassword').value = '';
        document.getElementById('resetPwModal').classList.remove('hidden');
      }
      function closeResetPwModal() {
        document.getElementById('resetPwModal').classList.add('hidden');
      }
      async function submitResetPassword(e) {
        e.preventDefault();
        const id = document.getElementById('resetPwUserId').value;
        const password = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const csrfToken = document.querySelector('#resetPwForm input[name="_csrf"]').value;

        if (password !== confirmPassword) return alert('Passwords do not match.');
        if (password.length < 8) return alert('Password must be at least 8 characters.');
        if (!/[A-Z]/.test(password) || !/[a-z]/.test(password) || !/\d/.test(password)) {
          return alert('Password needs at least 1 uppercase, 1 lowercase, and 1 number.');
        }

        const btn = e.target.querySelector('button[type="submit"]');
        btn.disabled = true;
        const origText = btn.textContent;
        btn.textContent = 'Resetting...';

        try {
          const res = await fetch('/admin/user/' + id + '/password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ password }),
          });
          const data = await res.json();
          if (data.success) {
            closeResetPwModal();
            alert('Password updated successfully!');
          } else {
            alert(data.message || 'Failed to reset password.');
          }
        } catch (err) {
          alert('Something went wrong.');
        } finally {
          btn.disabled = false;
          btn.textContent = origText;
        }
      }

      // Close modals on outside click
      document.getElementById('editUserModal').addEventListener('click', function(e) {
        if (e.target === this) closeEditModal();
      });
      document.getElementById('resetPwModal').addEventListener('click', function(e) {
        if (e.target === this) closeResetPwModal();
      });
    </script>

    <!-- Tutorials -->
    <section>
      <h3 class="text-xl font-semibold mb-4">Tutorials (<%= tutorials.length %>)</h3>
      <div class="space-y-3">
        <% tutorials.forEach(t => { %>
          <div class="bg-gray-800 border border-gray-700 rounded-xl p-4 flex items-center justify-between flex-wrap gap-3">
            <div class="flex-1 min-w-[200px]">
              <span class="inline-block text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full mb-1"><%= t.category || "General" %></span>
              <h4 class="font-semibold"><%= t.title %></h4>
              <p class="text-gray-400 text-sm"><%= t.description %></p>
            </div>
            <form method="POST" action="/admin/tutorial/<%= t._id %>/delete" onsubmit="return confirm('Delete this tutorial?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition">Delete</button>
            </form>
          </div>
        <% }) %>
        <% if (tutorials.length === 0) { %>
          <p class="text-gray-400">No tutorials yet.</p>
        <% } %>
      </div>
    </section>

    <!-- Blog Posts -->
    <section class="mt-10">
      <h3 class="text-xl font-semibold mb-4">Blog Posts (<%= blogs.length %>)</h3>

      <!-- Create New Post -->
      <form method="POST" action="/admin/blog" class="bg-gray-800 border border-gray-700 rounded-2xl p-6 mb-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <h4 class="font-bold mb-4">Create New Post</h4>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <input name="title" required placeholder="Post title" class="bg-gray-700 border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-indigo-500" />
          <input name="author" placeholder="Author (default: Zero to Pro Team)" class="bg-gray-700 border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-indigo-500" />
        </div>
        <textarea name="excerpt" rows="2" placeholder="Short excerpt (optional)" class="bg-gray-700 border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-indigo-500 w-full mb-4"></textarea>
        <textarea name="content" rows="6" required placeholder="Post content (HTML supported)" class="bg-gray-700 border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-indigo-500 w-full mb-4 font-mono"></textarea>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
          <input name="tags" placeholder="Tags (comma separated)" class="bg-gray-700 border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-indigo-500" />
          <input name="featuredImage" placeholder="Featured image URL (optional)" class="bg-gray-700 border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-indigo-500" />
        </div>
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 text-sm text-gray-300 cursor-pointer">
            <input type="checkbox" name="published" class="rounded border-gray-600 text-indigo-500 focus:ring-indigo-500" />
            Publish immediately
          </label>
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2 rounded-lg text-sm transition">Create Post</button>
        </div>
      </form>

      <!-- Existing Posts -->
      <div class="space-y-3">
        <% blogs.forEach(b => { %>
          <div class="bg-gray-800 border border-gray-700 rounded-xl p-4 flex items-center justify-between flex-wrap gap-3">
            <div class="flex-1 min-w-[200px]">
              <div class="flex items-center gap-2 mb-1">
                <span class="inline-block text-xs px-2 py-0.5 rounded-full <%= b.published ? 'bg-green-500/20 text-green-300' : 'bg-yellow-500/20 text-yellow-300' %>">
                  <%= b.published ? 'Published' : 'Draft' %>
                </span>
                <span class="text-xs text-gray-500"><%= b.views || 0 %> views</span>
              </div>
              <h4 class="font-semibold"><%= b.title %></h4>
              <p class="text-gray-400 text-sm"><%= b.excerpt || 'No excerpt' %></p>
              <div class="flex flex-wrap gap-1 mt-1">
                <% (b.tags || []).forEach(tag => { %>
                  <span class="text-xs bg-indigo-500/10 text-indigo-400 px-2 py-0.5 rounded-full"><%= tag %></span>
                <% }) %>
              </div>
            </div>
            <div class="flex gap-2">
              <form method="POST" action="/admin/blog/<%= b._id %>/toggle">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="bg-gray-700 hover:bg-gray-600 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition">
                  <%= b.published ? 'Unpublish' : 'Publish' %>
                </button>
              </form>
              <form method="POST" action="/admin/blog/<%= b._id %>/delete" onsubmit="return confirm('Delete this blog post?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
        <% if (blogs.length === 0) { %>
          <p class="text-gray-400">No blog posts yet. Create your first post above!</p>
        <% } %>
      </div>
    </section>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
