<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Admin Dashboard - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="container mx-auto max-w-5xl px-6 py-10 flex-1">
    <h2 class="text-3xl font-bold mb-2">Admin Dashboard</h2>
    <p class="text-gray-400 mb-8">Manage users and tutorials.</p>

    <% if (message) { %>
      <p class="mb-6 text-sm bg-green-500/10 border border-green-500/50 text-green-400 rounded-lg py-2 px-4"><%= message %></p>
    <% } %>
    <% if (error) { %>
      <p class="mb-6 text-sm bg-red-500/10 border border-red-500/50 text-red-400 rounded-lg py-2 px-4"><%= error %></p>
    <% } %>

    <!-- Users -->
    <section class="mb-10">
      <h3 class="text-xl font-semibold mb-4">Users (<%= users.length %>)</h3>
      <div class="bg-gray-800 border border-gray-700 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-700 text-left text-gray-300">
              <tr>
                <th class="px-4 py-3">Name</th>
                <th class="px-4 py-3">Email</th>
                <th class="px-4 py-3">Role</th>
                <th class="px-4 py-3">Joined</th>
                <th class="px-4 py-3">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
              <% users.forEach(u => { %>
                <tr>
                  <td class="px-4 py-3"><%= u.name %></td>
                  <td class="px-4 py-3 text-gray-400"><%= u.email %></td>
                  <td class="px-4 py-3">
                    <% if (u.role === 'admin') { %>
                      <span class="inline-block text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full">Admin</span>
                    <% } else { %>
                      <span class="inline-block text-xs bg-gray-600/30 text-gray-300 px-2 py-0.5 rounded-full">User</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-gray-400"><%= u.createdAt ? new Date(u.createdAt).toLocaleDateString() : '—' %></td>
                  <td class="px-4 py-3">
                    <% if (String(u._id) !== String(user.id)) { %>
                      <div class="flex gap-2">
                        <form method="POST" action="/admin/user/<%= u._id %>/role">
                          <button type="submit"
                            class="bg-gray-700 hover:bg-gray-600 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition">
                            <%= u.role === 'admin' ? 'Demote' : 'Promote' %>
                          </button>
                        </form>
                        <form method="POST" action="/admin/user/<%= u._id %>/delete"
                          onsubmit="return confirm('Delete user <%= u.name.replace(/'/g, "").replace(/"/g, "") %>? This cannot be undone.')">
                          <button type="submit"
                            class="bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition">Delete</button>
                        </form>
                      </div>
                    <% } else { %>
                      <span class="text-gray-500 text-xs">(you)</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Tutorials -->
    <section>
      <h3 class="text-xl font-semibold mb-4">Tutorials (<%= tutorials.length %>)</h3>
      <div class="space-y-3">
        <% tutorials.forEach(t => { %>
          <div class="bg-gray-800 border border-gray-700 rounded-xl p-4 flex items-center justify-between flex-wrap gap-3">
            <div class="flex-1 min-w-[200px]">
              <span class="inline-block text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full mb-1"><%= t.category || "General" %></span>
              <h4 class="font-semibold"><%= t.title %></h4>
              <p class="text-gray-400 text-sm"><%= t.description %></p>
            </div>
            <form method="POST" action="/admin/tutorial/<%= t._id %>/delete" onsubmit="return confirm('Delete this tutorial?')">
              <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition">Delete</button>
            </form>
          </div>
        <% }) %>
        <% if (tutorials.length === 0) { %>
          <p class="text-gray-400">No tutorials yet.</p>
        <% } %>
      </div>
    </section>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
