<!DOCTYPE html>
<html lang="en">
<%
  // Each language has its own accent color + logo (for the certificate card)
  const CATEGORY_COLORS = {
    HTML: ['#fbbf24', '#f97316'],
    CSS: ['#60a5fa', '#6366f1'],
    JavaScript: ['#facc15', '#f59e0b'],
    PHP: ['#a5b4fc', '#8b5cf6'],
    'C++': ['#38bdf8', '#2563eb'],
    React: ['#22d3ee', '#0891b2'],
    Bootstrap: ['#c084fc', '#7c3aed'],
    General: ['#34d399', '#059669'],
  };
  function accentColors(c) {
    return CATEGORY_COLORS[c] ? [CATEGORY_COLORS[c][0], CATEGORY_COLORS[c][1]] : ['#22d3ee', '#6366f1'];
  }
  // Language logos come from the controller (shared lib/languages.js) via `logos`.
  function langLogo(c) {
    return (logos && logos[c]) || '/logo/badge.png';
  }
  function logoAlt(c) {
    return (c || 'General') + ' logo';
  }
  function formatDate(d) {
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return '—';
    return dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  }
%>
<head>
  <%- include('../partials/head', { title: 'My Certificates - Zero to Pro' }) %>
  <!-- Elegant certificate typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Great+Vibes&display=swap" rel="stylesheet">
  <style>
    /* Print: show only the certificate cards, hide everything else */
    @media print {
      @page { margin: 0.4in; }
      body { background: #fff !important; }
      nav, footer, .no-print, .cert-header { display: none !important; }
      .certificate-card {
        background: #fff !important;
        border: 2px solid #d1d5db !important;
        box-shadow: none !important;
        break-inside: avoid;
      }
      .certificate-card > div { padding: 0 !important; background: none !important; }
      .certificate-card .cert-inner { background: #fff !important; padding: 1rem !important; }
      .certificate-card .cert-deco { display: none !important; }
      .certificate-card .cert-ring { background: #e5e7eb !important; }
      .certificate-card .cert-ring .bg-gray-900,
      .certificate-card .cert-inner { background: #fff !important; }
      .certificate-card .cert-score { background: #fff !important; border-color: #d1d5db !important; }
      .certificate-card .text-gray-50,
      .certificate-card .text-gray-100,
      .certificate-card .text-gray-300 { color: #111827 !important; }
      .certificate-card .text-gray-400,
      .certificate-card .text-gray-500 { color: #6b7280 !important; }
      .certificate-card .border-gray-800 { border-color: #e5e7eb !important; }
      .certificate-card .cert-name { color: #111827 !important; }
    }

    /* Light mode overrides */
    @media (prefers-color-scheme: light) {
      .cert-inner, html[data-theme="light"] .cert-inner { background: #fff !important; }
      .cert-ring .bg-gray-900, html[data-theme="light"] .cert-ring .bg-gray-900 { background: #fff !important; }
      .cert-deco, html[data-theme="light"] .cert-deco { opacity: 0.04 !important; }
      .text-gray-100, html[data-theme="light"] .text-gray-100 { color: #111827 !important; }
      .text-gray-50, html[data-theme="light"] .text-gray-50 { color: #1f2937 !important; }
      .text-gray-300, html[data-theme="light"] .text-gray-300 { color: #374151 !important; }
      .text-gray-400, html[data-theme="light"] .text-gray-400 { color: #6b7280 !important; }
      .text-gray-500, html[data-theme="light"] .text-gray-500 { color: #9ca3af !important; }
      .border-gray-800, html[data-theme="light"] .border-gray-800 { border-color: #e5e7eb !important; }
      html[data-theme="light"] .certificate-card { box-shadow: 0 4px 20px rgba(0,0,0,0.08) !important; }
      html[data-theme="light"] .certificate-card .cert-score { background: rgba(255,255,255,0.8) !important; }
      html[data-theme="light"] body .cert-header h1 { color: #111827 !important; }
      html[data-theme="light"] body .cert-header p { color: #6b7280 !important; }
    }

    /* Certificate recipient name: black in light mode, white/light-gray in dark mode.
       Written independent of Tailwind's dark: class variant so it works even if
       the theme toggle only sets data-theme (and not the .dark class) on <html>. */
    .cert-name { color: #000; }
    html[data-theme="light"] .cert-name,
    html:not(.dark):not([data-theme="dark"]) .cert-name { color: #000 !important; }
    html.dark .cert-name,
    html[data-theme="dark"] .cert-name { color: #f9fafb !important; }
  </style>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <main class="flex-1 py-14 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- ─── Heading ───────────────────────────────────────────────────── -->
      <div class="cert-header text-center mb-12">
        <div class="h-20 md:h-24 mx-auto mb-4 flex items-center justify-center">
          <img src="/logo/brand-icon.png" alt="Zero to Pro" class="h-full w-auto object-contain" />
        </div>
        <span class="text-sm font-bold uppercase tracking-widest text-indigo-400">Certificates</span>
        <h1 class="text-4xl md:text-5xl font-extrabold mt-2">My Certificates</h1>
        <p class="text-gray-400 mt-3 max-w-xl mx-auto">Pass each language's test (75% or more) and collect your verified Zero to Pro certificates here.</p>
      </div>

      <% if (typeof error !== "undefined" && error) { %>
        <p class="text-center text-red-400 bg-red-500/10 border border-red-500/50 rounded-lg py-3 px-4 mb-8"><%= error %></p>
      <% } %>

      <% if (!certificates || certificates.length === 0) { %>
        <!-- ─── No certificates ─────────────────────────────────────────── -->
        <div class="max-w-md mx-auto text-center bg-gray-800/50 border border-gray-700 rounded-3xl p-10">
          <div class="w-32 h-32 mx-auto flex items-center justify-center">
            <img src="/logo/badge.png" alt="Zero to Pro Badge" class="w-full h-full object-contain" />
          </div>
          <p class="text-[10px] uppercase tracking-widest text-gray-500 mt-3">No Badge Yet</p>
          <h2 class="text-2xl font-bold mt-4">No Certificates Yet</h2>
          <p class="text-gray-400 mt-3">
            You haven't passed a test yet. Complete any language quiz with at least
            <span class="text-white font-semibold">75%</span> score and your certificate
            will appear here automatically.
          </p>
          <a href="/test" class="no-print inline-block mt-8 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-7 py-3 rounded-xl transition">Take a Test</a>
        </div>
      <% } else { %>
        <!-- ─── Earned certificates ─────────────────────────────────────── -->
        <div class="grid md:grid-cols-1 lg:grid-cols-2 gap-8">
          <% certificates.forEach((cert, idx) => { %>
            <% const [c1, c2] = accentColors(cert.category); %>
            <article class="certificate-card rounded-2xl overflow-hidden shadow-xl shadow-black/20 transition hover:shadow-2xl">
              <!-- Gradient border frame -->
              <div class="h-full rounded-2xl p-[2px]" style="background:linear-gradient(135deg,<%= c1 %> 0%,<%= c2 %> 100%)">
                <div class="cert-inner bg-gray-900 rounded-[14px] h-full px-8 py-10 text-center relative overflow-hidden">

                  <!-- Decorative background wash -->
                  <div class="cert-deco pointer-events-none absolute inset-0 opacity-[0.06]" style="background-image:radial-gradient(circle at 15% 15%,<%= c1 %> 0,transparent 45%),radial-gradient(circle at 85% 85%,<%= c2 %> 0,transparent 45%)"></div>

                  <!-- Corner ornaments -->
                  <div class="cert-deco absolute top-4 left-4 w-8 h-8" style="border-top:2px solid <%= c1 %>;border-left:2px solid <%= c1 %>;border-top-left-radius:8px"></div>
                  <div class="cert-deco absolute top-4 right-4 w-8 h-8" style="border-top:2px solid <%= c2 %>;border-right:2px solid <%= c2 %>;border-top-right-radius:8px"></div>
                  <div class="cert-deco absolute bottom-4 left-4 w-8 h-8" style="border-bottom:2px solid <%= c1 %>;border-left:2px solid <%= c1 %>;border-bottom-left-radius:8px"></div>
                  <div class="cert-deco absolute bottom-4 right-4 w-8 h-8" style="border-bottom:2px solid <%= c2 %>;border-right:2px solid <%= c2 %>;border-bottom-right-radius:8px"></div>

                  <div class="relative">
                    <!-- Brand -->
                    <div class="flex items-center justify-center gap-2">
                      <img src="/logo/brand-icon.png" alt="Zero to Pro" class="h-6 w-6 object-contain" />
                      <span class="uppercase tracking-[0.35em] text-[11px] font-semibold text-gray-400">Zero to Pro</span>
                    </div>

                    <!-- Badge logo in a ring -->
                    <div class="cert-ring mt-6 mx-auto w-24 h-24 md:w-28 md:h-28 rounded-full p-[3px]" style="background:conic-gradient(from 210deg,<%= c1 %>,<%= c2 %>,<%= c1 %>)">
                      <div class="w-full h-full rounded-full bg-gray-900 overflow-hidden">
                        <img src="<%= langLogo(cert.category) %>" alt="<%= logoAlt(cert.category) %>" class="w-full h-full object-cover" />
                      </div>
                    </div>

                    <!-- Title -->
                    <p class="mt-6 text-xs uppercase tracking-[0.4em] font-bold" style="color:<%= c1 %>">Certificate of Achievement</p>
                    <h2 class="mt-2 text-3xl md:text-4xl font-bold text-gray-100" style="font-family:'Playfair Display', Georgia, serif">Certified</h2>

                    <!-- Divider -->
                    <div class="my-6 flex items-center justify-center gap-3">
                      <span class="h-px w-16" style="background:linear-gradient(90deg,transparent,<%= c1 %>)"></span>
                      <span class="text-sm" style="color:<%= c2 %>">✦</span>
                      <span class="h-px w-16" style="background:linear-gradient(90deg,<%= c2 %>,transparent)"></span>
                    </div>

                    <!-- Body -->
                    <p class="text-gray-400 text-sm">This certifies that</p>
                    <p class="cert-name mt-2 text-4xl md:text-5xl leading-tight" style="font-family:'Great Vibes', cursive"><%= user.name %></p>
                    <p class="mt-4 text-gray-400 text-sm">has successfully passed the</p>
                    <p class="mt-2 text-2xl md:text-3xl font-extrabold bg-clip-text text-transparent" style="background-image:linear-gradient(90deg,<%= c1 %>,<%= c2 %>)"><%= cert.category %> Certification Test</p>
                    <p class="mt-2 text-xs text-gray-500"><%= cert.testTitle %></p>

                    <!-- Score -->
                    <div class="cert-score mt-8 inline-flex items-center gap-3 rounded-full border px-6 py-3" style="border-color:<%= c2 %>55;background:<%= c2 %>14">
                      <span class="text-3xl font-extrabold leading-none" style="color:<%= c2 %>"><%= cert.percentage %>%</span>
                      <span class="text-left text-[11px] uppercase tracking-wider text-gray-400 leading-tight">Final<br/>Score</span>
                    </div>

                    <!-- Meta -->
                    <div class="mt-10 pt-6 border-t border-gray-800 flex flex-wrap justify-between gap-3 text-xs text-gray-500">
                      <span>Certificate ID: <span class="text-gray-300 font-mono"><%= cert.certId || "—" %></span></span>
                      <span>Issued: <span class="text-gray-300"><%= formatDate(cert.earnedAt) %></span></span>
                    </div>

                    <div class="no-print mt-6 flex flex-wrap items-center justify-center gap-3">
                      <button type="button" onclick="window.print()"
                        class="border border-gray-600 text-gray-300 hover:bg-gray-700 hover:text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition">
                        🖨️ Print
                      </button>
                      <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent('https://zerotopro.dev/certificates') %>"
                         target="_blank" rel="noopener noreferrer"
                         class="border border-gray-600 text-gray-300 hover:bg-[#0077b5]/20 hover:text-[#0077b5] hover:border-[#0077b5]/50 font-semibold px-5 py-2.5 rounded-lg text-sm transition inline-flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        Share
                      </a>
                      <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent('I just earned my ' + cert.category + ' Certificate from Zero to Pro! 🏆 #Coding #ZeroToPro #LearnToCode') %>&url=<%= encodeURIComponent('https://zerotopro.dev/certificates') %>"
                         target="_blank" rel="noopener noreferrer"
                         class="border border-gray-600 text-gray-300 hover:bg-[#1da1f2]/20 hover:text-[#1da1f2] hover:border-[#1da1f2]/50 font-semibold px-5 py-2.5 rounded-lg text-sm transition inline-flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
                        Tweet
                      </a>
                      <button type="button" onclick="copyCertLink(this)"
                        class="border border-gray-600 text-gray-300 hover:bg-gray-700 hover:text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition inline-flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                        Copy Link
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <p class="no-print text-center text-gray-500 text-sm mt-10">
          Want more? <a href="/test" class="text-indigo-400 hover:text-indigo-300 font-semibold">Take another test</a> to earn certificates for more languages.
        </p>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
  <script>
    function copyCertLink(btn) {
      const url = 'https://zerotopro.dev/certificates';
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          const orig = btn.innerHTML;
          btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
          btn.classList.add('text-green-400', 'border-green-500/50');
          setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('text-green-400', 'border-green-500/50'); }, 2000);
        });
      }
    }
  </script>
</body>
</html>
