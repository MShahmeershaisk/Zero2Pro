<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: mode === "attempt" ? test.title : 'Quizzes - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="container mx-auto max-w-4xl px-6 py-10 flex-1">
    <% if (mode === "list") { %>

      <h2 class="text-3xl font-bold mb-2">Available Tests</h2>
      <p class="text-gray-400 mb-8">
        Each attempt has up to <%= QUESTIONS_PER_ATTEMPT %> random questions from the language you select. A score of at least <%= PASS_PERCENTAGE %>% is required to pass.
      </p>

      <% if (typeof error !== "undefined" && error) { %>
        <div class="mb-6 text-sm bg-red-500/10 border border-red-500/50 text-red-400 rounded-lg py-2 px-4">
          <% if (error === "missing_category") { %>
            Please select a language before starting a test.
          <% } else if (error === "no_questions") { %>
            No questions are available for this language yet.
          <% } else { %>
            Something went wrong. Please try again.
          <% } %>
        </div>
      <% } %>

      <% if (!tests || tests.length === 0) { %>
        <p class="text-gray-400 text-center py-10">No tests are available right now.</p>
      <% } else { %>
        <div class="space-y-4">
          <% tests.forEach(function (t) { %>
            <div class="bg-gray-800 border border-gray-700 rounded-2xl p-6 flex items-center justify-between flex-wrap gap-4">
              <div class="min-w-[200px]">
                <h3 class="text-xl font-bold"><%= t.title %></h3>
              </div>
              <div class="flex gap-3 items-center">
                <select class="lang-select bg-gray-700 border border-gray-600 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                  <option value="" disabled selected>Select Language</option>
                  <% categories.forEach(function (cat) { %>
                    <option value="<%= cat %>" class="bg-gray-800"><%= cat %></option>
                  <% }) %>
                </select>
                <button class="start-btn bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-indigo-600"
                  disabled onclick="startSelectedTest('<%= t._id %>', this)">Start Test</button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <script>
        // Enable start buttons once a language is selected
        document.querySelectorAll('.lang-select').forEach(function (select) {
          const card = select.closest('div');
          const startBtn = card.querySelector('.start-btn');
          select.addEventListener('change', function () {
            startBtn.disabled = !select.value;
          });
        });

        function startSelectedTest(testId, btn) {
          const card = btn.closest('div');
          const category = card.querySelector('.lang-select').value;
          if (!category) {
            alert('Please select a language first.');
            return;
          }
          window.location.href = '/test/' + testId + '?category=' + encodeURIComponent(category);
        }
      </script>

    <% } else if (mode === "attempt") { %>

      <div id="quizApp"></div>

      <script type="application/json" id="quiz-data">
        <%- JSON.stringify({
          testId: test._id,
          title: test.title,
          category: category,
          questions: safeQuestions,
          passPercentage: PASS_PERCENTAGE
        }).replace(/</g, "\\u003c") %>
      </script>

      <script src="/js/csstest.js"></script>

    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
