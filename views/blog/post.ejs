<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: post.title + ' - Zero to Pro Blog' }) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  <style>
    .post-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 30%, #172554 60%, #0c1a3d 100%);
      padding: 60px 20px 50px;
    }
    html[data-theme="light"] .post-hero {
      background: linear-gradient(180deg, #0c4652 0%, #123a8a 45%, #0a1a6b 75%, #060c33 100%);
    }
    .post-content {
      font-family: 'Inter', sans-serif;
      font-size: 17px;
      line-height: 1.8;
      color: #cbd5e1;
    }
    html[data-theme="light"] .post-content {
      color: #334155;
    }
    .post-content h1 { font-size: 2rem; font-weight: 700; margin: 2rem 0 1rem; color: #f1f5f9; }
    .post-content h2 { font-size: 1.5rem; font-weight: 700; margin: 1.8rem 0 0.8rem; color: #f1f5f9; }
    .post-content h3 { font-size: 1.25rem; font-weight: 600; margin: 1.5rem 0 0.6rem; color: #e2e8f0; }
    html[data-theme="light"] .post-content h1,
    html[data-theme="light"] .post-content h2,
    html[data-theme="light"] .post-content h3 { color: #0f172a; }
    .post-content p { margin-bottom: 1.2rem; }
    .post-content ul, .post-content ol { margin-bottom: 1.2rem; padding-left: 1.5rem; }
    .post-content li { margin-bottom: 0.5rem; }
    .post-content code {
      font-family: 'Fira Code', monospace;
      background: rgba(99, 102, 241, 0.1);
      color: #a5b4fc;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.9em;
    }
    html[data-theme="light"] .post-content code {
      background: rgba(99, 102, 241, 0.06);
      color: #4f46e5;
    }
    .post-content pre {
      background: #0d1117;
      border: 1px solid #1f2937;
      border-radius: 12px;
      padding: 1.2rem;
      overflow-x: auto;
      margin-bottom: 1.5rem;
    }
    html[data-theme="light"] .post-content pre {
      background: #f8fafc;
      border-color: #e2e8f0;
    }
    .post-content pre code {
      background: none;
      padding: 0;
      color: #e5e7eb;
    }
    html[data-theme="light"] .post-content pre code {
      color: #1e293b;
    }
    .post-content blockquote {
      border-left: 3px solid #6366f1;
      padding-left: 1rem;
      margin: 1.5rem 0;
      color: #94a3b8;
      font-style: italic;
    }
    html[data-theme="light"] .post-content blockquote {
      color: #64748b;
    }
    .post-content img {
      max-width: 100%;
      border-radius: 12px;
      margin: 1.5rem 0;
    }
    .post-content a {
      color: #818cf8;
      text-decoration: underline;
    }
    .post-content a:hover {
      color: #a5b4fc;
    }
    .post-share-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid #334155;
      background: #1e293b;
      color: #94a3b8;
      transition: all 0.2s ease;
    }
    .post-share-btn:hover {
      background: #334155;
      color: #e2e8f0;
    }
    html[data-theme="light"] .post-share-btn {
      background: #ffffff;
      border-color: #e2e8f0;
      color: #475569;
    }
    html[data-theme="light"] .post-share-btn:hover {
      background: #f1f5f9;
      color: #1e293b;
    }
  </style>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <!-- Post Header -->
  <section class="post-hero">
    <div class="max-w-3xl mx-auto">
      <a href="/blog" class="text-sm text-indigo-400 hover:underline mb-4 inline-block">&larr; Back to Blog</a>

      <% if (post.tags && post.tags.length > 0) { %>
        <div class="flex flex-wrap gap-2 mb-4">
          <% post.tags.forEach(tag => { %>
            <a href="/blog/tag/<%= tag %>" class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/15 text-indigo-400 border border-indigo-500/25 hover:bg-indigo-500/25 transition">
              <%= tag %>
            </a>
          <% }) %>
        </div>
      <% } %>

      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight"><%= post.title %></h1>

      <div class="flex items-center gap-4 mt-5 text-sm text-gray-400">
        <span><%= post.author %></span>
        <span>&middot;</span>
        <span><%= new Date(post.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        <span>&middot;</span>
        <span><%= post.views || 0 %> views</span>
      </div>
    </div>
  </section>

  <!-- Featured Image -->
  <% if (post.featuredImage) { %>
    <div class="max-w-3xl mx-auto -mt-6 px-6 relative z-10">
      <img src="<%= post.featuredImage %>" alt="<%= post.title %>" class="w-full rounded-2xl shadow-2xl" />
    </div>
  <% } %>

  <!-- Post Content -->
  <main class="flex-1 px-6 py-12">
    <article class="max-w-3xl mx-auto">
      <div class="post-content">
        <%- post.content %>
      </div>

      <!-- Share Section -->
      <div class="mt-12 pt-8 border-t border-gray-700">
        <h3 class="text-lg font-bold mb-4">Share this article</h3>
        <div class="flex flex-wrap gap-3">
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent('https://zerotopro.dev/blog/' + post.slug) %>"
             target="_blank" rel="noopener noreferrer" class="post-share-btn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title + ' — Zero to Pro Blog') %>&url=<%= encodeURIComponent('https://zerotopro.dev/blog/' + post.slug) %>"
             target="_blank" rel="noopener noreferrer" class="post-share-btn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
            Twitter
          </a>
        </div>
      </div>
    </article>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
