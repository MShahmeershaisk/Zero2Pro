<% if (typeof user === "undefined") user = null; %>
<footer class="bg-gray-800 border-t border-gray-700 mt-16">
  <div class="max-w-6xl mx-auto px-6 py-14">
    <!-- Top: Brand + badges -->
    <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 mb-10">
      <div class="text-center md:text-left">
        <a href="/" class="text-2xl font-bold tracking-wide bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">Zero to Pro</a>
        <p class="text-gray-500 text-sm mt-2 max-w-xs mx-auto md:mx-0">
          From absolute beginner to industry professional. Learn to code with interactive tutorials, quizzes and a compiler.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <img src="/logo/Group 22.png" alt="Badge" class="h-10 object-contain opacity-80" />
      </div>
    </div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 border-t border-gray-700 pt-10">
      <!-- Tutorials -->
      <div>
        <h4 class="text-white font-bold mb-4">Tutorials</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          <li><a href="/tutorials/html" class="hover:text-indigo-400 transition">HTML</a></li>
          <li><a href="/tutorials/css" class="hover:text-indigo-400 transition">CSS</a></li>
          <li><a href="/tutorials/javascript" class="hover:text-indigo-400 transition">JavaScript</a></li>
          <li><a href="/tutorials/php" class="hover:text-indigo-400 transition">PHP</a></li>
          <li><a href="/tutorials/cpp" class="hover:text-indigo-400 transition">C++</a></li>
          <li><a href="/tutorials/react" class="hover:text-indigo-400 transition">React</a></li>
          <li><a href="/tutorials/bootstrap" class="hover:text-indigo-400 transition">Bootstrap</a></li>
        </ul>
      </div>

      <!-- Exercises -->
      <div>
        <h4 class="text-white font-bold mb-4">Exercises</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          <li><a href="/test" class="hover:text-indigo-400 transition">Quizzes</a></li>
          <li><a href="/test" class="hover:text-indigo-400 transition">Exercises</a></li>
          <li><a href="/test" class="hover:text-indigo-400 transition">Weekly Problem</a></li>
        </ul>
      </div>

      <!-- Certificate -->
      <div>
        <h4 class="text-white font-bold mb-4">Certificate</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          <li><a href="/certificates" class="hover:text-indigo-400 transition">HTML Certificate</a></li>
          <li><a href="/certificates" class="hover:text-indigo-400 transition">CSS Certificate</a></li>
          <li><a href="/certificates" class="hover:text-indigo-400 transition">JavaScript Certificate</a></li>
          <li><a href="/certificates" class="hover:text-indigo-400 transition">All Certificates</a></li>
        </ul>
      </div>

      <!-- Account -->
      <div>
        <h4 class="text-white font-bold mb-4">Account</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          <% if (user) { %>
            <li><a href="/profile" class="hover:text-indigo-400 transition">My Profile</a></li>
            <li><a href="/logout" class="hover:text-indigo-400 transition">Logout</a></li>
          <% } else { %>
            <li><a href="/login" class="hover:text-indigo-400 transition">Login</a></li>
            <li><a href="/signup" class="hover:text-indigo-400 transition">Sign Up</a></li>
          <% } %>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-gray-700 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-sm">&copy; <%= new Date().getFullYear() %> Zero to Pro. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-gray-500 hover:text-indigo-400 transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://x.com/" target="_blank" rel="noopener noreferrer" aria-label="X" class="text-gray-500 hover:text-indigo-400 transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
        </a>
        <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-gray-500 hover:text-indigo-400 transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-500 hover:text-indigo-400 transition">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
