<% if (typeof user === "undefined") user = null; %>
<nav class="bg-gray-900/80 backdrop-blur border-b border-gray-800 px-6 py-4 shadow-lg sticky top-0 z-50">
  <div class="flex justify-between items-center max-w-6xl mx-auto">
    <!-- Logo (LEFT) -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/logo/brand-icon.png" alt="Zero to Pro" class="h-9 w-9 object-contain rounded" />
      <span class="text-lg font-bold tracking-wider uppercase bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">Zero to Pro</span>
    </a>

    <!-- Desktop Navigation (CENTER) -->
    <div class="hidden lg:flex space-x-6 items-center absolute left-1/2 -translate-x-1/2">
      <a href="/tutorials" class="text-gray-300 hover:text-indigo-400 font-medium transition text-sm">TUTORIALS</a>
      <a href="/test" class="text-gray-300 hover:text-indigo-400 font-medium transition text-sm">EXERCISES</a>
      <a href="/compiler" class="text-gray-300 hover:text-indigo-400 font-medium transition text-sm">COMPILER</a>
      <a href="/blog" class="text-gray-300 hover:text-indigo-400 font-medium transition text-sm">BLOG</a>
      <a href="/certificates" class="text-gray-300 hover:text-indigo-400 font-medium transition text-sm">CERTIFICATES</a>
      <% if (user) { %>
        <a href="/profile" class="text-gray-300 hover:text-indigo-400 font-medium transition text-sm">PROFILE</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="text-gray-300 hover:text-indigo-400 font-medium transition text-sm">ADMIN</a>
        <% } %>
      <% } %>
    </div>

    <!-- Desktop Right Section: Search + Theme + Auth (RIGHT) -->
    <div class="hidden lg:flex items-center gap-3 shrink-0">
      <button id="themeToggle" class="nav-theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark/light mode" title="Toggle dark/light mode">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>
      <% if (user) { %>
        <!-- Messenger icon — links to chat/messages -->
        <a href="/chat" class="relative text-gray-300 hover:text-white transition" title="Messages">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
            <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center"><%= unreadMessages > 9 ? '9+' : unreadMessages %></span>
          <% } %>
        </a>
        <a href="/profile" class="text-gray-300 hover:text-white text-sm" title="Profile">
          <span class="w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold"><%= user.name.charAt(0).toUpperCase() %></span>
        </a>
        <form method="POST" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">Logout</button>
        </form>
      <% } else { %>
        <a href="/login" class="text-gray-300 hover:text-white font-medium transition text-sm">Login</a>
        <a href="/signup" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">Sign Up</a>
      <% } %>
    </div>

    <!-- Hamburger Button (visible on mobile/tablet only) -->
    <button id="mobileMenuBtn" class="lg:hidden text-gray-300 hover:text-white focus:outline-none p-2 rounded-lg hover:bg-gray-800 transition">
      <svg id="hamburgerIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu (hidden by default) -->
  <div id="mobileMenu" class="hidden lg:hidden mt-4 pb-4 border-t border-gray-700">
    <div class="flex flex-col space-y-3 pt-4">
      <button class="nav-theme-toggle nav-theme-toggle-mobile" onclick="toggleTheme()" aria-label="Toggle dark/light mode" title="Toggle dark/light mode">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
        <span id="themeToggleLabel">Switch to Light Mode</span>
      </button>
      <a href="/tutorials" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800">Tutorials</a>
      <a href="/test" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800">Exercises</a>
      <a href="/compiler" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800">Compiler</a>
      <a href="/blog" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800">Blog</a>
      <a href="/certificates" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800">Certificates</a>
      <% if (user) { %>
        <a href="/chat" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Messages
          <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
            <span class="w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center"><%= unreadMessages > 9 ? '9+' : unreadMessages %></span>
          <% } %>
        </a>
        <a href="/profile" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800">Profile</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin" class="text-gray-300 hover:text-indigo-400 font-medium transition py-2 px-2 rounded-lg hover:bg-gray-800">Admin</a>
        <% } %>
        <!-- Mobile User Info & Logout -->
        <div class="pt-3 mt-3 border-t border-gray-700">
          <a href="/profile" class="flex items-center gap-2 text-gray-300 hover:text-white py-2 px-2 rounded-lg hover:bg-gray-800 mb-2">
            <span class="w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold"><%= user.name.charAt(0).toUpperCase() %></span>
          </a>
          <form method="POST" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="block w-full text-center bg-red-600 hover:bg-red-700 text-white px-4 py-2.5 rounded-lg text-sm font-semibold transition">Logout</button>
          </form>
        </div>
      <% } else { %>
        <!-- Mobile Login/Signup -->
        <div class="pt-3 mt-3 border-t border-gray-700 flex flex-col space-y-2">
          <a href="/login" class="text-center text-gray-300 hover:text-white font-medium transition py-2.5 px-4 rounded-lg border border-gray-600 hover:bg-gray-800">Login</a>
          <a href="/signup" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-lg text-sm font-semibold text-center transition">Sign Up</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');

  mobileMenuBtn.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    if (isOpen) {
      mobileMenu.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    } else {
      mobileMenu.classList.remove('hidden');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    }
  });

  // Close mobile menu when clicking a link
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    });
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!mobileMenuBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
      mobileMenu.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  });
</script>
