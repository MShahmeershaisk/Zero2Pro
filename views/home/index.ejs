  <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
  <script>
    if (typeof AOS !== 'undefined') {
      AOS.init({ once: true, offset: 60, duration: 650, easing: 'ease-out-cubic' });
    }

    // Typewriter: writes the current code into #codePreview line-by-line the
    // first time the editor scrolls into view (blinking cursor at the end).
    var typeTimer = null;
    function startTypewriter() {
      var wrap = document.getElementById('codePreview');
      if (!wrap || wrap.dataset.typed) return;
      wrap.dataset.typed = 'done';
      var pre = wrap.querySelector('pre');
      if (!pre) return;
      var lines = pre.innerHTML.split('\n');
      wrap.innerHTML = '<pre class="text-gray-300"></pre>';
      var out = wrap.querySelector('pre');
      var i = 0;
      function tick() {
        if (i < lines.length) {
          out.innerHTML += lines[i] + '\n';
          i++;
          typeTimer = setTimeout(tick, 45);
        } else {
          out.innerHTML = out.innerHTML.replace(/\n$/, '') + '<span class="tw-cursor"></span>';
          typeTimer = null;
        }
      }
      tick();
    }
    var codeWrap = document.querySelector('.lp-code-wrap');
    if ('IntersectionObserver' in window && codeWrap) {
      var ioWatcher = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { startTypewriter(); ioWatcher.disconnect(); }
        });
      }, { threshold: .35 });
      ioWatcher.observe(codeWrap);
    } else if (codeWrap) {
      startTypewriter();
    }

    // Language carousel click handler
    document.querySelectorAll('[data-lang]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-lang]').forEach(b => {
          b.classList.remove('active');
        });
        btn.classList.add('active');

        const lang = btn.dataset.lang;
        const data = langCodes[lang];
        if (data) {
          // A manual pick cancels any in-flight typewriter and shows code instantly
          if (typeof typeTimer !== 'undefined' && typeTimer) { clearTimeout(typeTimer); typeTimer = null; }
          const wrap = document.getElementById('codePreview');
          if (wrap) wrap.dataset.typed = 'done';
          document.getElementById('editorLangLabel').textContent = data.label;
          document.getElementById('codePreview').innerHTML = '<pre class="text-gray-300">' + data.code + '</pre>';
        }
      });
    });
  </script>
