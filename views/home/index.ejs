<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'DevHub - Home' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col justify-between">

  <!-- Navigation Bar -->
  <nav class="bg-gray-800 border-b border-gray-700 px-6 py-4 flex justify-between items-center shadow-lg">
    <a href="/" class="text-2xl font-bold text-indigo-500 tracking-wide">DevHub</a>
    
    <div class="hidden md:flex space-x-6">
      <a href="/" class="text-indigo-400 font-semibold">Home</a>
      <% if (user) { %>
        <a href="/home" class="hover:text-indigo-400 font-medium transition">Tutorials Dashboard</a>
      <% } %>
      <a href="/compiler" class="hover:text-indigo-400 font-medium transition">Compiler</a>
      <a href="/tests" class="hover:text-indigo-400 font-medium transition">Quizzes & Tests</a>
      <a href="/ai" class="hover:text-indigo-400 font-medium transition">AI Assistant</a>
    </div>

    <div>
      <% if (user) { %>
        <span class="mr-4 text-gray-300">Hi, <strong class="text-white"><%= user.username || user.name || 'Developer' %></strong></span>
        <a href="/logout" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">Logout</a>
      <% } else { %>
        <a href="/login" class="mr-3 text-gray-300 hover:text-white font-medium transition">Login</a>
        <a href="/register" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">Sign Up</a>
      <% } %>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="container mx-auto px-6 py-16 text-center max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-tight">
      Master Coding with <span class="text-indigo-500">Interactive Tools & AI</span>
    </h1>
    <p class="text-lg text-gray-400 mb-8">
      Compile code in real-time, test your programming knowledge with quizzes, managed custom tutorials, and get intelligent AI assistance all in one place.
    </p>
    
    <div class="flex flex-wrap justify-center gap-4">
      <% if (user) { %>
        <a href="/home" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition">Go to Dashboard</a>
      <% } else { %>
        <a href="/register" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition">Get Started Free</a>
      <% } %>
      <a href="/compiler" class="bg-gray-800 hover:bg-gray-700 text-gray-200 border border-gray-600 font-semibold px-6 py-3 rounded-xl transition">Open Code Compiler</a>
    </div>
  </header>

  <!-- Feature Grid -->
  <main class="container mx-auto px-6 py-8 grid md:grid-cols-3 gap-8">
    <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-md flex flex-col justify-between">
      <div>
        <div class="text-indigo-400 text-3xl mb-4">⚡</div>
        <h3 class="text-xl font-bold mb-2">Live Code Compiler</h3>
        <p class="text-gray-400 text-sm">Write, execute, and debug your code live directly from your browser.</p>
      </div>
      <a href="/compiler" class="mt-6 text-indigo-400 hover:underline font-semibold text-sm">Launch Compiler &rarr;</a>
    </div>

    <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-md flex flex-col justify-between">
      <div>
        <div class="text-indigo-400 text-3xl mb-4">📝</div>
        <h3 class="text-xl font-bold mb-2">Quizzes & Tests</h3>
        <p class="text-gray-400 text-sm">Evaluate your understanding across multiple categories with automated tests.</p>
      </div>
      <a href="/tests" class="mt-6 text-indigo-400 hover:underline font-semibold text-sm">Take a Test &rarr;</a>
    </div>

    <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-md flex flex-col justify-between">
      <div>
        <div class="text-indigo-400 text-3xl mb-4">🤖</div>
        <h3 class="text-xl font-bold mb-2">AI Assistant</h3>
        <p class="text-gray-400 text-sm">Get instant code explanations, step-by-step guidance, and debugging help.</p>
      </div>
      <a href="/ai" class="mt-6 text-indigo-400 hover:underline font-semibold text-sm">Chat with AI &rarr;</a>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 border-t border-gray-700 text-center py-6 text-gray-500 text-sm mt-12">
    &copy; <%= new Date().getFullYear() %> DevHub. All rights reserved.
  </footer>

</body>
</html>