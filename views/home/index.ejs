<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Zero to Pro - Learn & Practice Coding' }) %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
  <style>
    /* ============================================================
       LANDING PAGE — matches Website/index.html
       Dark = default (current app dark styling)
       Light = exact Website/index.html colors
       ============================================================ */

    /* ---------- HERO + COLLABORATIONS ---------- */
    .lp-hero {
      background: linear-gradient(135deg,#0f172a 0%,#1e293b 30%,#172554 60%,#0c1a3d 100%);
      color: #fff;
      padding: 0 20px 80px;
    }
    html[data-theme="light"] .lp-hero {
      background: linear-gradient(180deg,#0c4652 0%, #123a8a 45%, #0a1a6b 75%, #060c33 100%);
    }
    .lp-hero-inner { max-width: 1000px; margin: 0 auto; padding: 64px 8px 0; text-align: center; }
    .lp-hero-glass {
      background: rgba(255,255,255,.07);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 1.75rem;
      padding: 3rem 2rem;
      box-shadow: 0 24px 60px rgba(2,6,23,.35), inset 0 1px 0 rgba(255,255,255,.08);
    }
    html[data-theme="light"] .lp-hero-glass {
      background: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,.04));
      border: 1px solid rgba(255,255,255,.35);
      border-top-color: rgba(255,255,255,.55);
      box-shadow: 0 8px 32px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.4);
    }
    .lp-hero h1 { font-size: 40px; line-height: 1.25; font-weight: 700; margin: 0 0 18px; color: #fff; }
    @media (max-width: 600px) { .lp-hero h1 { font-size: 28px; } }
    .lp-hl {
      background: #3b6bf5; color: #fff; padding: 1px 9px; border-radius: 5px;
      font-style: italic; font-family: 'Consolas','SFMono-Regular','Courier New',monospace;
      font-weight: 700; line-height: 1.35; box-decoration-break: clone; -webkit-box-decoration-break: clone;
    }
    .lp-hero-sub { font-size: 15px; color: rgba(255,255,255,.82); max-width: 560px; margin: 0 auto; line-height: 1.6; }
    .lp-ctas { display: flex; justify-content: center; gap: 14px; margin-top: 30px; flex-wrap: wrap; }
    .lp-btn {
      padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 600;
      border: 1px solid transparent; cursor: pointer; display: inline-block; text-decoration: none;
      transition: transform .15s ease, background .15s ease, color .15s ease;
    }
    .lp-btn:hover { transform: translateY(-1px); }
    .lp-btn-primary { background: linear-gradient(135deg,#6366f1,#4f46e5); color: #fff; }
    .lp-btn-primary:hover { background: linear-gradient(135deg,#4f46e5,#4338ca); }
    html[data-theme="light"] .lp-btn-primary { background: #3b6bf5; box-shadow: 0 4px 14px rgba(59,107,245,.3); }
    html[data-theme="light"] .lp-btn-primary:hover { background: #5b8bff; }
    .lp-btn-outline { background: transparent; border-color: rgba(255,255,255,.55); color: #fff; }
    .lp-btn-outline:hover { background: rgba(255,255,255,.12); }

    .lp-collab { margin-top: 64px; text-align: center; }
    .lp-collab h3 { font-size: 22px; font-weight: 700; color: #fff; margin: 0 0 28px; letter-spacing: .3px; }
    .lp-collab-logos { display: flex; justify-content: center; align-items: center; gap: 52px; flex-wrap: wrap; opacity: .95; }
    .lp-collab-logos img { height: 38px; width: auto; object-fit: contain; }
    @media (max-width: 700px) { .lp-collab-logos { gap: 26px; } .lp-collab-logos img { height: 32px; } }

    /* ---------- APP INTRO ---------- */
    .lp-app { position: relative; margin-top: -46px; padding: 0 20px 60px; z-index: 2; }
    .lp-app-card {
      max-width: 1080px; margin: 0 auto; background: #1e293b; border: 1px solid #334155;
      border-radius: 28px; box-shadow: 0 30px 60px rgba(10,20,60,.28);
      display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 52px 56px;
    }
    html[data-theme="light"] .lp-app-card { background: #dceafe; border: none; box-shadow: 0 30px 60px rgba(10,20,60,.18); }
    .lp-app-text h2 { font-size: 40px; font-weight: 700; line-height: 1.15; margin: 0 0 6px; color: #fff; }
    html[data-theme="light"] .lp-app-text h2 { color: #111318; }
    .lp-app-text p { color: #94a3b8; font-size: 15px; max-width: 420px; line-height: 1.6; margin: 18px 0 26px; }
    html[data-theme="light"] .lp-app-text p { color: #4b5563; }
    .lp-store-btns { display: flex; gap: 14px; }
    .lp-store-btn { width: 160px; height: 52px; display: flex; align-items: center; justify-content: center; }
    .lp-store-btn img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
    @media (max-width: 860px) {
      .lp-app-card { flex-direction: column; text-align: center; padding: 36px 24px; }
      .lp-app-text p { margin-left: auto; margin-right: auto; }
      .lp-store-btns { justify-content: center; }
    }

    /* ---------- TUTORIALS ---------- */
    .lp-tutorials { background: #111827; padding: 70px 0; text-align: center; }
    html[data-theme="light"] .lp-tutorials { background: #f4f5f7; }
    .lp-eyebrow { color: #818cf8; font-size: 12px; font-weight: 700; letter-spacing: 1px; margin-bottom: 10px; }
    html[data-theme="light"] .lp-eyebrow { color: #3b6bf5; }
    .lp-tutorials h2, .lp-langs h2, .lp-practice h2 { font-size: 32px; font-weight: 700; margin: 0 0 10px; color: #fff; }
    html[data-theme="light"] .lp-tutorials h2, html[data-theme="light"] .lp-langs h2, html[data-theme="light"] .lp-practice h2 { color: #111318; }
    .lp-tutorials p, .lp-langs p, .lp-practice p { color: #94a3b8; font-size: 14px; margin: 0 0 34px; }
    html[data-theme="light"] .lp-tutorials p, html[data-theme="light"] .lp-langs p, html[data-theme="light"] .lp-practice p { color: #4b5563; }
    .lp-icon-carousel { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 36px; flex-wrap: wrap; }
    .lp-arrow {
      width: 34px; height: 34px; border-radius: 50%; border: 1px solid #475569; background: #1f2937;
      color: #94a3b8; display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer; line-height: 0;
    }
    html[data-theme="light"] .lp-arrow { border-color: #e5e7eb; background: #fff; color: #6b7280; }
    .lp-arrow svg { display: block; width: 14px; height: 14px; }
    .lp-lang-circle {
      width: 64px; height: 64px; border-radius: 50%; background: #1f2937; border: 1px solid #334155;
      display: flex; align-items: center; justify-content: center; padding: 8px; overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,.2); cursor: pointer; transition: border-color .2s;
    }
    html[data-theme="light"] .lp-lang-circle { background: #fff; border: 1px solid #e5e7eb; box-shadow: 0 2px 6px rgba(0,0,0,.04); }
    .lp-lang-circle.active { border: 2px solid #3b6bf5; box-shadow: 0 4px 12px rgba(59,107,245,.25); }
    .lp-lang-circle img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .lp-code-wrap {
      background: #0d1117; border: 1px solid #1f2937; border-radius: 14px; overflow: hidden;
      max-width: 680px; margin: 0 auto 28px; text-align: left; box-shadow: 0 10px 30px rgba(0,0,0,.3);
    }
    html[data-theme="light"] .lp-code-wrap { border-color: #e5e7eb; box-shadow: 0 10px 30px rgba(0,0,0,.08); }

    /* ---------- LANGUAGES WE OFFER ---------- */
    .lp-langs { background: #0f172a; padding: 70px 0; text-align: center; }
    html[data-theme="light"] .lp-langs { background: #fff; }
    .lp-lang-cards { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; }
    .lp-lang-card {
      width: 112px; height: 112px; border: 1px solid #334155; border-radius: 14px; background: #1f2937;
      display: flex; align-items: center; justify-content: center; padding: 14px; overflow: hidden;
    }
    html[data-theme="light"] .lp-lang-card { border-color: #e5e7eb; background: #fff; }
    .lp-lang-card img { max-width: 100%; max-height: 100%; object-fit: contain; }

    /* ---------- STUDY ANYWHERE ---------- */
    .lp-study { padding: 60px 20px; }
    .lp-study-inner {
      max-width: 1080px; margin: 0 auto; background: #134e4a; border-radius: 24px; padding: 52px 56px;
      display: flex; align-items: center; justify-content: space-between; gap: 40px;
    }
    html[data-theme="light"] .lp-study-inner { background: #bdeee1; }
    .lp-study-text h2 { font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 16px; color: #fff; }
    html[data-theme="light"] .lp-study-text h2 { color: #111318; }
    .lp-study-text p { color: #9ca3af; font-size: 15px; line-height: 1.7; max-width: 420px; margin: 0 0 22px; }
    html[data-theme="light"] .lp-study-text p { color: #374151; }
    .lp-study-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 32px; font-size: 13.5px; font-weight: 600; color: #fff; }
    html[data-theme="light"] .lp-study-list { color: #111318; }
    .lp-study-list li { display: flex; align-items: center; gap: 8px; }
    .lp-study-list li::before { content: "✓"; color: #0f9d58; font-weight: 700; }
    .lp-signin-card {
      background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 30px 32px;
      width: 300px; flex-shrink: 0; box-shadow: 0 20px 40px rgba(0,0,0,.2); text-align: center;
    }
    html[data-theme="light"] .lp-signin-card { background: #fff; border: 1px solid #e2e8f0; box-shadow: 0 20px 40px rgba(0,0,0,.08); }
    .lp-signin-card h3 { font-size: 18px; font-weight: 700; margin: 0 0 8px; color: #fff; }
    html[data-theme="light"] .lp-signin-card h3 { color: #111318; }
    .lp-signin-card p { font-size: 12.5px; color: #94a3b8; line-height: 1.5; margin: 0 0 22px; }
    html[data-theme="light"] .lp-signin-card p { color: #4b5563; }
    .lp-btn-full { display: block; width: 100%; padding: 11px 0; border-radius: 8px; font-size: 13px; font-weight: 600; margin-bottom: 10px; border: 1px solid transparent; cursor: pointer; }
    .lp-btn-signin { background: #334155; color: #fff; border: 1px solid #475569; }
    html[data-theme="light"] .lp-btn-signin { background: #fff; border: 1px solid #d1d5db; color: #111318; }
    .lp-divider-or { font-size: 11px; color: #9ca3af; margin: 8px 0; font-weight: 600; }
    .lp-btn-signup { background: #3b6bf5; color: #fff; }
    html[data-theme="light"] .lp-btn-signup:hover { background: #5b8bff; }
    .lp-welcome-name { color: #fff; font-weight: 600; }
    html[data-theme="light"] .lp-welcome-name { color: #111318; }
    .lp-welcome-sub { color: #94a3b8; font-size: 13px; }
    html[data-theme="light"] .lp-welcome-sub { color: #4b5563; }
    @media (max-width: 860px) {
      .lp-study-inner { flex-direction: column; text-align: center; padding: 36px 24px; }
      .lp-study-text p { margin-left: auto; margin-right: auto; }
      .lp-signin-card { width: 100%; }
      .lp-study-list { text-align: left; }
    }

    /* ---------- CERTIFICATES ---------- */
    .lp-certs { background: #111827; padding: 70px 0; }
    html[data-theme="light"] .lp-certs { background: #f4f5f7; }
    .lp-certs-inner { max-width: 1080px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 0 20px; }
    .lp-certs-text .lp-eyebrow { text-align: left; }
    .lp-certs-text h2 { font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 16px; color: #fff; }
    html[data-theme="light"] .lp-certs-text h2 { color: #111318; }
    .lp-certs-text p { color: #94a3b8; font-size: 14px; max-width: 400px; line-height: 1.7; margin: 0 0 24px; }
    html[data-theme="light"] .lp-certs-text p { color: #4b5563; }
    .lp-certs-ctas { display: flex; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
    .lp-btn-line { background: #1f2937; color: #fff; border: 1px solid #475569; }
    .lp-btn-line:hover { background: #334155; }
    html[data-theme="light"] .lp-btn-line { background: #fff; color: #111318; border: 1px solid #d1d5db; }
    html[data-theme="light"] .lp-btn-line:hover { background: #f1f5f9; }
    .lp-verified { font-size: 13px; font-weight: 600; color: #fff; }
    html[data-theme="light"] .lp-verified { color: #111318; }
    .lp-verified::before { content: "✓ "; color: #0f9d58; font-weight: 700; }
    .lp-badge { width: 260px; height: 260px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; filter: drop-shadow(0 12px 24px rgba(0,0,0,.2)); }
    .lp-badge img { width: 100%; height: 100%; object-fit: contain; }
    @media (max-width: 860px) {
      .lp-certs-inner { flex-direction: column; text-align: center; }
      .lp-certs-text .lp-eyebrow { text-align: center; }
      .lp-certs-text p { margin-left: auto; margin-right: auto; }
      .lp-certs-ctas { justify-content: center; }
    }

    /* ---------- PRACTICE ---------- */
    .lp-practice { background: #0f172a; padding: 70px 0; text-align: center; }
    html[data-theme="light"] .lp-practice { background: #fff; }
    .lp-practice p { margin: 0 0 30px; }
    .lp-practice-ctas { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }

    /* ============================================================
       HERO 3D ILLUSTRATION + ANIMATIONS (home page)
       Deep-blue -> turquoise workspace, floating code icons,
       neon isometric grid, glassmorphism chips, glowing lines
       ============================================================ */
    .lp-hero { position: relative; overflow: hidden; }
    .lp-hero-inner { position: relative; z-index: 2; }
    .lp-hero-glass { position: relative; z-index: 2; }

    /* animated aurora blobs */
    .lp-blob { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; z-index: 0; }
    .lp-blob-1 { width: 440px; height: 440px; top: -140px; left: -120px;
      background: radial-gradient(circle at 30% 30%, #22d3ee, #0ea5e9); opacity: .5;
      animation: lpBlob 18s ease-in-out infinite; }
    .lp-blob-2 { width: 380px; height: 380px; bottom: -160px; right: -90px;
      background: radial-gradient(circle at 30% 30%, #4f46e5, #06b6d4); opacity: .45;
      animation: lpBlob 22s ease-in-out infinite reverse; }
    .lp-blob-3 { width: 300px; height: 300px; top: 42%; left: 58%;
      background: radial-gradient(circle at 30% 30%, #0ea5e9, #14b8a6); opacity: .38;
      animation: lpBlob 26s ease-in-out infinite; }
    @keyframes lpBlob { 0%,100% { transform: translate(0,0) scale(1); }
      33% { transform: translate(46px,-34px) scale(1.08); } 66% { transform: translate(-34px,28px) scale(.93); } }

    /* isometric neon floor grid (recedes into the screen) */
    .lp-neon-grid {
      position: absolute; left: -10%; right: -10%; bottom: -5%; top: 30%; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(34,211,238,.09) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34,211,238,.09) 1px, transparent 1px);
      background-size: 48px 48px;
      transform: perspective(700px) rotateX(58deg) translateY(12%);
      transform-origin: 50% 100%;
      mask-image: radial-gradient(ellipse 75% 60% at 50% 35%, #000 35%, transparent 78%);
      -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 35%, #000 35%, transparent 78%);
      animation: lpGrid 2.4s linear infinite;
    }
    html[data-theme="light"] .lp-neon-grid { opacity: .6; }
    @keyframes lpGrid { from { background-position: 0 0; } to { background-position: 0 48px; } }

    /* neon glow line accents */
    .lp-neon-line { position: absolute; z-index: 0; height: 2px; border-radius: 999px; pointer-events: none;
      background: linear-gradient(90deg, transparent, #22d3ee 25%, #34d399 75%, transparent);
      box-shadow: 0 0 14px rgba(34,211,238,.7); animation: lpLine 4.5s ease-in-out infinite; }
    .ln-1 { width: 300px; top: 18%; left: 4%; transform: rotate(-24deg); }
    .ln-2 { width: 260px; bottom: 16%; right: 3%; transform: rotate(18deg); }
    html[data-theme="light"] .lp-neon-line { opacity: .8; }
    @keyframes lpLine { 0%,100% { opacity: .30; } 50% { opacity: .75; } }

    /* floating glossy language icons */
    .lp-float-ico {
      position: absolute; z-index: 1; display: flex; align-items: center; justify-content: center;
      width: 52px; height: 52px; border-radius: 15px;
      background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.2);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      box-shadow: 0 12px 30px rgba(2,6,23,.4), inset 0 1px 0 rgba(255,255,255,.18);
      animation: lpFloat 6s ease-in-out infinite;
      filter: drop-shadow(0 8px 16px rgba(34,211,238,.22));
    }
    .lp-float-ico img { width: 58%; height: 58%; object-fit: contain; }
    .lp-float-ico.f-1 { top: 13%; left: 5%; }
    .lp-float-ico.f-2 { top: 22%; right: 6%; animation-delay: 1.2s; }
    .lp-float-ico.f-3 { bottom: 24%; left: 9%; animation-delay: 2s; }
    .lp-float-ico.f-4 { bottom: 30%; right: 9%; animation-delay: 3s; }
    .lp-float-ico.f-5 { top: 7%; left: 43%; width: 44px; height: 44px; animation-delay: .6s; }
    .lp-float-ico.f-6 { bottom: 6%; right: 42%; width: 44px; height: 44px; animation-delay: 1.8s; }
    @keyframes lpFloat { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-16px) rotate(2deg); } }

    /* glassmorphism status chips */
    .lp-glass-chip {
      position: absolute; z-index: 1; display: flex; align-items: center; gap: 8px;
      padding: 8px 14px; border-radius: 12px; font-size: 12px; font-weight: 600; color: #e2e8f0;
      background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.2);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 8px 24px rgba(2,6,23,.3); animation: lpFloat 7.5s ease-in-out infinite;
    }
    .lp-glass-chip .g-dot { width: 8px; height: 8px; border-radius: 50%; box-shadow: 0 0 8px currentColor; }
    .lp-glass-chip.g-1 { left: 12%; bottom: 12%; }
    .lp-glass-chip.g-2 { right: 14%; top: 40%; animation-delay: 2.4s; }
    .lp-glass-chip.g-3 { left: 38%; top: 6%; animation-delay: 4s; }
    .g-1 .g-dot { background: #34d399; color: #34d399; }
    .g-2 .g-dot { background: #fbbf24; color: #fbbf24; }
    .g-3 .g-dot { background: #38bdf8; color: #38bdf8; }

    /* ---- APP / PHONE: 3D float + glowing aura + orbiting badges ---- */
    .lp-phone-wrap { position: relative; }
    .phone-mockup { animation: lpPhoneFloat 6s ease-in-out infinite; will-change: transform; }
    @keyframes lpPhoneFloat { 0%,100% { transform: translateY(0) rotate(-1.2deg); } 50% { transform: translateY(-16px) rotate(1.2deg); } }
    .lp-phone-aura { position: absolute; inset: -16%; z-index: -1; border-radius: 50%;
      background: radial-gradient(circle, rgba(34,211,238,.35), rgba(79,70,229,.2) 45%, transparent 70%);
      filter: blur(14px); animation: lpAura 6s ease-in-out infinite; }
    @keyframes lpAura { 0%,100% { opacity: .55; transform: scale(1); } 50% { opacity: 1; transform: scale(1.06); } }
    .lp-phone-badge {
      position: absolute; z-index: 2; width: 52px; height: 52px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center; font-size: 22px;
      background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      box-shadow: 0 12px 26px rgba(2,6,23,.35); animation: lpPhoneFloat 5s ease-in-out infinite;
    }
    html[data-theme="light"] .lp-phone-badge { background: rgba(255,255,255,.85); }
    .lp-pb-1 { top: -4%; left: -18%; animation-delay: .2s; }
    .lp-pb-2 { top: 24%; right: -20%; animation-delay: 1.2s; }
    .lp-pb-3 { bottom: 6%; left: -14%; animation-delay: 2.2s; }
    .lp-pb-4 { bottom: 26%; right: -14%; animation-delay: 3.2s; }

    /* ---- LANGUAGES SECTION: glossy floating icons + particles ---- */
    .lp-langs { position: relative; overflow: hidden; }
    .lp-lang-card { position: relative; animation: lpBob 5s ease-in-out infinite; will-change: transform; }
    .lp-lang-cards .lp-lang-card:nth-child(2n) { animation-delay: .8s; }
    .lp-lang-cards .lp-lang-card:nth-child(3n) { animation-delay: 1.6s; }
    .lp-lang-card:hover { animation: none; transform: translateY(-8px) scale(1.06); border-color: #22d3ee;
      box-shadow: 0 14px 30px rgba(34,211,238,.18); transition: transform .2s ease, border-color .2s, box-shadow .2s; }
    .lp-lang-card::before { content:""; position: absolute; top: 0; left: 12%; right: 12%; height: 40%;
      border-radius: 12px 12px 0 0; background: linear-gradient(180deg, rgba(255,255,255,.25), transparent); pointer-events: none; }
    @keyframes lpBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
    .lp-particle { position: absolute; width: 6px; height: 6px; border-radius: 50%; pointer-events: none; z-index: 0; bottom: 6%;
      background: rgba(34,211,238,.65); box-shadow: 0 0 10px rgba(34,211,238,.8); animation: lpRise 9s linear infinite; }
    html[data-theme="light"] .lp-particle { background: rgba(59,107,245,.6); box-shadow: 0 0 10px rgba(59,107,245,.7); }
    @keyframes lpRise { 0% { transform: translateY(30px); opacity: 0; } 25% { opacity: .8; } 100% { transform: translateY(-120px); opacity: 0; } }

    /* ============================================================
       ROUND 2 — LOAD & SCROLL ANIMATIONS (home page)
       ============================================================ */

    /* 1) Hero headline + CTAs — staggered Fade-Up on page load */
    .hero-fade { opacity: 0; transform: translateY(28px); animation: hfUp .8s cubic-bezier(.22,.61,.36,1) forwards; }
    .hf-1 { animation-delay: .15s; }
    .hf-2 { animation-delay: .35s; }
    .hf-3 { animation-delay: .55s; }
    @keyframes hfUp { to { opacity: 1; transform: translateY(0); } }

    /* 1b) Hero background — soft floating ambient glow (pulse) */
    .lp-hero::after {
      content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(58% 52% at 50% 10%, rgba(34,211,238,.16), rgba(79,70,229,.10) 42%, transparent 74%);
      animation: lpGlow 6s ease-in-out infinite;
    }
    @keyframes lpGlow { 0%,100% { opacity: .5; transform: scale(1); } 50% { opacity: 1; transform: scale(1.05); } }

    /* 2) Our Collaborations — infinite marquee scroll */
    .lp-collab-logos.lp-marquee { overflow: hidden; justify-content: flex-start; flex-wrap: nowrap; gap: 0; }
    .lp-collab-logos.lp-marquee .lp-marquee-track,
    .lp-collab-logos.lp-marquee .lp-marquee-half { display: flex; align-items: center; width: max-content; }
    .lp-collab-logos.lp-marquee .lp-marquee-half { gap: 52px; padding-right: 52px; }
    .lp-collab-logos.lp-marquee .lp-marquee-track { gap: 0; animation: lpMarquee 28s linear infinite; will-change: transform; }
    .lp-collab-logos.lp-marquee:hover .lp-marquee-track { animation-play-state: paused; }
    @keyframes lpMarquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @media (max-width: 700px) {
      .lp-collab-logos.lp-marquee .lp-marquee-half { gap: 26px; padding-right: 26px; }
    }

    /* 4) Language icons — hover zoom 1.1 + glow; arrows subtle side-bounce */
    .lp-lang-circle { transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .lp-lang-circle:hover { transform: scale(1.1); border-color: #38bdf8; box-shadow: 0 6px 20px rgba(56,189,248,.35); }
    html[data-theme="light"] .lp-lang-circle:hover { border-color: #3b6bf5; box-shadow: 0 6px 20px rgba(59,107,245,.3); }
    .lp-arrow { transition: transform .25s ease, color .2s ease, border-color .2s ease; }
    .lp-arrow:hover { color: #22d3ee; border-color: rgba(34,211,238,.6); }
    .lp-arrow:first-child:hover { animation: lpArrowL .55s ease infinite; }
    .lp-arrow:last-child:hover { animation: lpArrowR .55s ease infinite; }
    @keyframes lpArrowL { 0%,100% { transform: translateX(0); } 50% { transform: translateX(-4px); } }
    @keyframes lpArrowR { 0%,100% { transform: translateX(0); } 50% { transform: translateX(4px); } }

    /* 3/5) Typewriter — blinking cursor at the end of the code lines */
    .tw-cursor { display: inline-block; width: 9px; height: 15px; margin-left: 2px; vertical-align: -2px;
      background: #22d3ee; animation: twBlink .85s steps(2, start) infinite; }
    @keyframes twBlink { to { visibility: hidden; } }

    /* 6) Certificate badge — shine sweep across the badge (with AOS zoom pop-in) */
    .lp-badge { position: relative; overflow: hidden; border-radius: 999px; }
    .lp-badge::after {
      content: ""; position: absolute; top: 0; left: -130%; width: 65%; height: 100%;
      background: linear-gradient(105deg, transparent, rgba(255,255,255,.55), transparent);
      transform: skewX(-20deg); animation: lpShine 3.2s ease-in-out infinite;
    }
    @keyframes lpShine { 0%, 55% { left: -130%; } 85%, 100% { left: 135%; } }

    /* AOS horizontal offsets must never create a scrolling page */
    body { overflow-x: hidden; }

    /* Kill/soften everything for users who ask for less motion */
    @media (prefers-reduced-motion: reduce) {
      .hero-fade { animation: none; opacity: 1; transform: none; }
      .lp-hero::after,
      .lp-collab-logos.lp-marquee .lp-marquee-track,
      .lp-arrow:first-child:hover, .lp-arrow:last-child:hover,
      .lp-badge::after, .tw-cursor { animation: none !important; }
      [data-aos] { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    /* responsiveness + reduced motion */
    @media (max-width: 760px) {
      .lp-float-ico, .lp-glass-chip, .lp-neon-line { display: none; }
      .lp-phone-badge { width: 44px; height: 44px; font-size: 18px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lp-blob, .lp-neon-grid, .lp-neon-line, .lp-float-ico, .lp-glass-chip,
      .phone-mockup, .lp-phone-aura, .lp-phone-badge, .lp-lang-card, .lp-particle { animation: none !important; }
    }
  </style>
</head>
