  <!-- ============================================================
       FOOTER
       ============================================================ -->
  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

  <!-- Language carousel + code preview switching -->
  <script>
    const langCodes = {
      html: {
        label: 'HTML Example',
        code: '<span class="text-pink-400">&lt;!DOCTYPE html&gt;</span>\n<span class="text-pink-400">&lt;html&gt;</span>\n  <span class="text-pink-400">&lt;head&gt;</span>\n    <span class="text-pink-400">&lt;title&gt;</span><span class="text-emerald-400">HTML Tutorial</span><span class="text-pink-400">&lt;/title&gt;</span>\n  <span class="text-pink-400">&lt;/head&gt;</span>\n  <span class="text-pink-400">&lt;body&gt;</span>\n    <span class="text-pink-400">&lt;h1&gt;</span><span class="text-emerald-400">This is a heading</span><span class="text-pink-400">&lt;/h1&gt;</span>\n    <span class="text-pink-400">&lt;p&gt;</span><span class="text-emerald-400">This is a paragraph.</span><span class="text-pink-400">&lt;/p&gt;</span>\n  <span class="text-pink-400">&lt;/body&gt;</span>\n<span class="text-pink-400">&lt;/html&gt;</span>'
      },
      css: {
        label: 'CSS Example',
        code: '<span class="text-pink-400">body</span> {\n  <span class="text-blue-400">background-color</span>: <span class="text-emerald-400">#f0f0f0</span>;\n  <span class="text-blue-400">font-family</span>: <span class="text-emerald-400">Arial, sans-serif</span>;\n  <span class="text-blue-400">margin</span>: <span class="text-emerald-400">0</span>;\n  <span class="text-blue-400">padding</span>: <span class="text-emerald-400">20px</span>;\n}\n\n<span class="text-pink-400">h1</span> {\n  <span class="text-blue-400">color</span>: <span class="text-emerald-400">#333</span>;\n  <span class="text-blue-400">text-align</span>: <span class="text-emerald-400">center</span>;\n}'
      },
      java: {
        label: 'Java Example',
        code: '<span class="text-pink-400">public class</span> <span class="text-blue-400">HelloWorld</span> {\n  <span class="text-pink-400">public static void</span> <span class="text-emerald-400">main</span>(String[] args) {\n    System.out.<span class="text-emerald-400">println</span>(<span class="text-emerald-400">"Hello, World!"</span>);\n  }\n}'
      },
      javascript: {
        label: 'JavaScript Example',
        code: '<span class="text-pink-400">const</span> <span class="text-blue-400">message</span> = <span class="text-emerald-400">"Hello, Zero to Pro!"</span>;\n\n<span class="text-pink-400">function</span> <span class="text-emerald-400">greet</span>(name) {\n  <span class="text-pink-400">return</span> <span class="text-emerald-400">`Welcome, ${</span>name<span class="text-emerald-400">}!`</span>;\n}\n\nconsole.<span class="text-emerald-400">log</span>(<span class="text-emerald-400">greet</span>(message));'
      },
      php: {
        label: 'PHP Example',
        code: '<span class="text-pink-400">&lt;?php</span>\n<span class="text-blue-400">$name</span> = <span class="text-emerald-400">"Zero to Pro"</span>;\n\n<span class="text-pink-400">function</span> <span class="text-emerald-400">sayHello</span>(<span class="text-blue-400">$name</span>) {\n  <span class="text-pink-400">return</span> <span class="text-emerald-400">"Hello, "</span> . <span class="text-blue-400">$name</span> . <span class="text-emerald-400">"!"</span>;\n}\n\n<span class="text-pink-400">echo</span> <span class="text-emerald-400">sayHello</span>(<span class="text-blue-400">$name</span>);'
      },
      cpp: {
        label: 'C++ Example',
        code: '<span class="text-pink-400">#include</span> <span class="text-emerald-400">&lt;iostream&gt;</span>\n\n<span class="text-pink-400">using namespace</span> std;\n\n<span class="text-pink-400">int</span> <span class="text-emerald-400">main</span>() {\n  cout &lt;&lt; <span class="text-emerald-400">"Hello, Zero to Pro!"</span> &lt;&lt; endl;\n  <span class="text-pink-400">return</span> <span class="text-emerald-400">0</span>;\n}'
      },
      react: {
        label: 'React Example',
        code: '<span class="text-pink-400">import</span> React <span class="text-pink-400">from</span> <span class="text-emerald-400">\'react\'</span>;\n\n<span class="text-pink-400">function</span> <span class="text-emerald-400">App</span>() {\n  <span class="text-pink-400">return</span> (\n    &lt;<span class="text-blue-400">div</span> className=<span class="text-emerald-400">"app"</span>&gt;\n      &lt;<span class="text-blue-400">h1</span>&gt;Hello, Zero to Pro!&lt;/<span class="text-blue-400">h1</span>&gt;\n    &lt;/<span class="text-blue-400">div</span>&gt;\n  );\n}'
      },
      bootstrap: {
        label: 'Bootstrap Example',
        code: '<span class="text-pink-400">&lt;div</span> class=<span class="text-emerald-400">"container"</span><span class="text-pink-400">&gt;</span>\n  <span class="text-pink-400">&lt;div</span> class=<span class="text-emerald-400">"row"</span><span class="text-pink-400">&gt;</span>\n    <span class="text-pink-400">&lt;div</span> class=<span class="text-emerald-400">"col-md-6"</span><span class="text-pink-400">&gt;</span>\n      <span class="text-pink-400">&lt;h1&gt;</span>Hello World<span class="text-pink-400">&lt;/h1&gt;</span>\n      <span class="text-pink-400">&lt;button</span> class=<span class="text-emerald-400">"btn btn-primary"</span><span class="text-pink-400">&gt;</span>\n        Click Me\n      <span class="text-pink-400">&lt;/button&gt;</span>\n    <span class="text-pink-400">&lt;/div&gt;</span>\n  <span class="text-pink-400">&lt;/div&gt;</span>\n<span class="text-pink-400">&lt;/div&gt;</span>'
      }
    };

    // Language carousel click handler
    document.querySelectorAll('[data-lang]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-lang]').forEach(b => {
          b.classList.remove('active');
        });
        btn.classList.add('active');

        const lang = btn.dataset.lang;
        const data = langCodes[lang];
        if (data) {
          document.getElementById('editorLangLabel').textContent = data.label;
          document.getElementById('codePreview').innerHTML = '<pre class="text-gray-300">' + data.code + '</pre>';
        }
      });
    });
  </script>
</body>
</html>
