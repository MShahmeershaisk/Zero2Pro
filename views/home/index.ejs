<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Zero to Pro - Learn & Practice Coding' }) %>
  <style>
    /* ============================================================
       LANDING PAGE — matches Website/index.html
       Dark = default (current app dark styling)
       Light = exact Website/index.html colors
       ============================================================ */

    /* ---------- HERO + COLLABORATIONS ---------- */
    .lp-hero {
      background: linear-gradient(135deg,#0f172a 0%,#1e293b 30%,#172554 60%,#0c1a3d 100%);
      color: #fff;
      padding: 0 20px 80px;
    }
    html[data-theme="light"] .lp-hero {
      background: linear-gradient(180deg,#0c4652 0%, #123a8a 45%, #0a1a6b 75%, #060c33 100%);
    }
    .lp-hero-inner { max-width: 1000px; margin: 0 auto; padding: 64px 8px 0; text-align: center; }
    .lp-hero-glass {
      background: rgba(255,255,255,.07);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 1.75rem;
      padding: 3rem 2rem;
      box-shadow: 0 24px 60px rgba(2,6,23,.35), inset 0 1px 0 rgba(255,255,255,.08);
    }
    html[data-theme="light"] .lp-hero-glass {
      background: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,.04));
      border: 1px solid rgba(255,255,255,.35);
      border-top-color: rgba(255,255,255,.55);
      box-shadow: 0 8px 32px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.4);
    }
    .lp-hero h1 { font-size: 40px; line-height: 1.25; font-weight: 700; margin: 0 0 18px; color: #fff; }
    @media (max-width: 600px) { .lp-hero h1 { font-size: 28px; } }
    .lp-hl {
      background: #3b6bf5; color: #fff; padding: 1px 9px; border-radius: 5px;
      font-style: italic; font-family: 'Consolas','SFMono-Regular','Courier New',monospace;
      font-weight: 700; line-height: 1.35; box-decoration-break: clone; -webkit-box-decoration-break: clone;
    }
    .lp-hero-sub { font-size: 15px; color: rgba(255,255,255,.82); max-width: 560px; margin: 0 auto; line-height: 1.6; }
    .lp-ctas { display: flex; justify-content: center; gap: 14px; margin-top: 30px; flex-wrap: wrap; }
    .lp-btn {
      padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 600;
      border: 1px solid transparent; cursor: pointer; display: inline-block; text-decoration: none;
      transition: transform .15s ease, background .15s ease, color .15s ease;
    }
    .lp-btn:hover { transform: translateY(-1px); }
    .lp-btn-primary { background: linear-gradient(135deg,#6366f1,#4f46e5); color: #fff; }
    .lp-btn-primary:hover { background: linear-gradient(135deg,#4f46e5,#4338ca); }
    html[data-theme="light"] .lp-btn-primary { background: #3b6bf5; box-shadow: 0 4px 14px rgba(59,107,245,.3); }
    html[data-theme="light"] .lp-btn-primary:hover { background: #5b8bff; }
    .lp-btn-outline { background: transparent; border-color: rgba(255,255,255,.55); color: #fff; }
    .lp-btn-outline:hover { background: rgba(255,255,255,.12); }

    .lp-collab { margin-top: 64px; text-align: center; }
    .lp-collab h3 { font-size: 22px; font-weight: 700; color: #fff; margin: 0 0 28px; letter-spacing: .3px; }
    .lp-collab-logos { display: flex; justify-content: center; align-items: center; gap: 52px; flex-wrap: wrap; opacity: .95; }
    .lp-collab-logos img { height: 38px; width: auto; object-fit: contain; }
    @media (max-width: 700px) { .lp-collab-logos { gap: 26px; } .lp-collab-logos img { height: 32px; } }

    /* ---------- APP INTRO ---------- */
    .lp-app { position: relative; margin-top: -46px; padding: 0 20px 60px; z-index: 2; }
    .lp-app-card {
      max-width: 1080px; margin: 0 auto; background: #1e293b; border: 1px solid #334155;
      border-radius: 28px; box-shadow: 0 30px 60px rgba(10,20,60,.28);
      display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 52px 56px;
    }
    html[data-theme="light"] .lp-app-card { background: #dceafe; border: none; box-shadow: 0 30px 60px rgba(10,20,60,.18); }
    .lp-app-text h2 { font-size: 40px; font-weight: 700; line-height: 1.15; margin: 0 0 6px; color: #fff; }
    html[data-theme="light"] .lp-app-text h2 { color: #111318; }
    .lp-app-text p { color: #94a3b8; font-size: 15px; max-width: 420px; line-height: 1.6; margin: 18px 0 26px; }
    html[data-theme="light"] .lp-app-text p { color: #4b5563; }
    .lp-store-btns { display: flex; gap: 14px; }
    .lp-store-btn { width: 160px; height: 52px; display: flex; align-items: center; justify-content: center; }
    .lp-store-btn img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
    @media (max-width: 860px) {
      .lp-app-card { flex-direction: column; text-align: center; padding: 36px 24px; }
      .lp-app-text p { margin-left: auto; margin-right: auto; }
      .lp-store-btns { justify-content: center; }
    }

    /* ---------- TUTORIALS ---------- */
    .lp-tutorials { background: #111827; padding: 70px 0; text-align: center; }
    html[data-theme="light"] .lp-tutorials { background: #f4f5f7; }
    .lp-eyebrow { color: #818cf8; font-size: 12px; font-weight: 700; letter-spacing: 1px; margin-bottom: 10px; }
    html[data-theme="light"] .lp-eyebrow { color: #3b6bf5; }
    .lp-tutorials h2, .lp-langs h2, .lp-practice h2 { font-size: 32px; font-weight: 700; margin: 0 0 10px; color: #fff; }
    html[data-theme="light"] .lp-tutorials h2, html[data-theme="light"] .lp-langs h2, html[data-theme="light"] .lp-practice h2 { color: #111318; }
    .lp-tutorials p, .lp-langs p, .lp-practice p { color: #94a3b8; font-size: 14px; margin: 0 0 34px; }
    html[data-theme="light"] .lp-tutorials p, html[data-theme="light"] .lp-langs p, html[data-theme="light"] .lp-practice p { color: #4b5563; }
    .lp-icon-carousel { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 36px; flex-wrap: wrap; }
    .lp-arrow {
      width: 34px; height: 34px; border-radius: 50%; border: 1px solid #475569; background: #1f2937;
      color: #94a3b8; display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer; line-height: 0;
    }
    html[data-theme="light"] .lp-arrow { border-color: #e5e7eb; background: #fff; color: #6b7280; }
    .lp-arrow svg { display: block; width: 14px; height: 14px; }
    .lp-lang-circle {
      width: 64px; height: 64px; border-radius: 50%; background: #1f2937; border: 1px solid #334155;
      display: flex; align-items: center; justify-content: center; padding: 8px; overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,.2); cursor: pointer; transition: border-color .2s;
    }
    html[data-theme="light"] .lp-lang-circle { background: #fff; border: 1px solid #e5e7eb; box-shadow: 0 2px 6px rgba(0,0,0,.04); }
    .lp-lang-circle.active { border: 2px solid #3b6bf5; box-shadow: 0 4px 12px rgba(59,107,245,.25); }
    .lp-lang-circle img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .lp-code-wrap {
      background: #0d1117; border: 1px solid #1f2937; border-radius: 14px; overflow: hidden;
      max-width: 680px; margin: 0 auto 28px; text-align: left; box-shadow: 0 10px 30px rgba(0,0,0,.3);
    }
    html[data-theme="light"] .lp-code-wrap { border-color: #e5e7eb; box-shadow: 0 10px 30px rgba(0,0,0,.08); }

    /* ---------- LANGUAGES WE OFFER ---------- */
    .lp-langs { background: #0f172a; padding: 70px 0; text-align: center; }
    html[data-theme="light"] .lp-langs { background: #fff; }
    .lp-lang-cards { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; }
    .lp-lang-card {
      width: 112px; height: 112px; border: 1px solid #334155; border-radius: 14px; background: #1f2937;
      display: flex; align-items: center; justify-content: center; padding: 14px; overflow: hidden;
    }
    html[data-theme="light"] .lp-lang-card { border-color: #e5e7eb; background: #fff; }
    .lp-lang-card img { max-width: 100%; max-height: 100%; object-fit: contain; }

    /* ---------- STUDY ANYWHERE ---------- */
    .lp-study { padding: 60px 20px; }
    .lp-study-inner {
      max-width: 1080px; margin: 0 auto; background: #134e4a; border-radius: 24px; padding: 52px 56px;
      display: flex; align-items: center; justify-content: space-between; gap: 40px;
    }
    html[data-theme="light"] .lp-study-inner { background: #bdeee1; }
    .lp-study-text h2 { font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 16px; color: #fff; }
    html[data-theme="light"] .lp-study-text h2 { color: #111318; }
    .lp-study-text p { color: #9ca3af; font-size: 15px; line-height: 1.7; max-width: 420px; margin: 0 0 22px; }
    html[data-theme="light"] .lp-study-text p { color: #374151; }
    .lp-study-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 32px; font-size: 13.5px; font-weight: 600; color: #fff; }
    html[data-theme="light"] .lp-study-list { color: #111318; }
    .lp-study-list li { display: flex; align-items: center; gap: 8px; }
    .lp-study-list li::before { content: "✓"; color: #0f9d58; font-weight: 700; }
    .lp-signin-card {
      background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 30px 32px;
      width: 300px; flex-shrink: 0; box-shadow: 0 20px 40px rgba(0,0,0,.2); text-align: center;
    }
    html[data-theme="light"] .lp-signin-card { background: #fff; border: 1px solid #e2e8f0; box-shadow: 0 20px 40px rgba(0,0,0,.08); }
    .lp-signin-card h3 { font-size: 18px; font-weight: 700; margin: 0 0 8px; color: #fff; }
    html[data-theme="light"] .lp-signin-card h3 { color: #111318; }
    .lp-signin-card p { font-size: 12.5px; color: #94a3b8; line-height: 1.5; margin: 0 0 22px; }
    html[data-theme="light"] .lp-signin-card p { color: #4b5563; }
    .lp-btn-full { display: block; width: 100%; padding: 11px 0; border-radius: 8px; font-size: 13px; font-weight: 600; margin-bottom: 10px; border: 1px solid transparent; cursor: pointer; }
    .lp-btn-signin { background: #334155; color: #fff; border: 1px solid #475569; }
    html[data-theme="light"] .lp-btn-signin { background: #fff; border: 1px solid #d1d5db; color: #111318; }
    .lp-divider-or { font-size: 11px; color: #9ca3af; margin: 8px 0; font-weight: 600; }
    .lp-btn-signup { background: #3b6bf5; color: #fff; }
    html[data-theme="light"] .lp-btn-signup:hover { background: #5b8bff; }
    .lp-welcome-name { color: #fff; font-weight: 600; }
    html[data-theme="light"] .lp-welcome-name { color: #111318; }
    .lp-welcome-sub { color: #94a3b8; font-size: 13px; }
    html[data-theme="light"] .lp-welcome-sub { color: #4b5563; }
    @media (max-width: 860px) {
      .lp-study-inner { flex-direction: column; text-align: center; padding: 36px 24px; }
      .lp-study-text p { margin-left: auto; margin-right: auto; }
      .lp-signin-card { width: 100%; }
      .lp-study-list { text-align: left; }
    }

    /* ---------- CERTIFICATES ---------- */
    .lp-certs { background: #111827; padding: 70px 0; }
    html[data-theme="light"] .lp-certs { background: #f4f5f7; }
    .lp-certs-inner { max-width: 1080px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 0 20px; }
    .lp-certs-text .lp-eyebrow { text-align: left; }
    .lp-certs-text h2 { font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 16px; color: #fff; }
    html[data-theme="light"] .lp-certs-text h2 { color: #111318; }
    .lp-certs-text p { color: #94a3b8; font-size: 14px; max-width: 400px; line-height: 1.7; margin: 0 0 24px; }
    html[data-theme="light"] .lp-certs-text p { color: #4b5563; }
    .lp-certs-ctas { display: flex; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
    .lp-btn-line { background: #1f2937; color: #fff; border: 1px solid #475569; }
    .lp-btn-line:hover { background: #334155; }
    html[data-theme="light"] .lp-btn-line { background: #fff; color: #111318; border: 1px solid #d1d5db; }
    html[data-theme="light"] .lp-btn-line:hover { background: #f1f5f9; }
    .lp-verified { font-size: 13px; font-weight: 600; color: #fff; }
    html[data-theme="light"] .lp-verified { color: #111318; }
    .lp-verified::before { content: "✓ "; color: #0f9d58; font-weight: 700; }
    .lp-badge { width: 260px; height: 260px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; filter: drop-shadow(0 12px 24px rgba(0,0,0,.2)); }
    .lp-badge img { width: 100%; height: 100%; object-fit: contain; }
    @media (max-width: 860px) {
      .lp-certs-inner { flex-direction: column; text-align: center; }
      .lp-certs-text .lp-eyebrow { text-align: center; }
      .lp-certs-text p { margin-left: auto; margin-right: auto; }
      .lp-certs-ctas { justify-content: center; }
    }

    /* ---------- PRACTICE ---------- */
    .lp-practice { background: #0f172a; padding: 70px 0; text-align: center; }
    html[data-theme="light"] .lp-practice { background: #fff; }
    .lp-practice p { margin: 0 0 30px; }
    .lp-practice-ctas { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  </style>
</head>
<body class="font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <!-- ============================================================
       HERO + OUR COLLABORATIONS
       ============================================================ -->
  <section class="hero-section lp-hero">
    <div class="lp-hero-inner">
      <div class="lp-hero-glass">
        <h1>From <span class="lp-hl">Zero</span> to <span class="lp-hl">Pro</span></h1>
        <p class="lp-hero-sub">
          Master high-demand skills with structured learning paths designed to take you from zero to career-ready.
        </p>
        <div class="lp-ctas">
          <% if (user) { %>
            <a href="/tutorials" class="lp-btn lp-btn-primary">Explore Courses</a>
          <% } else { %>
            <a href="/signup" class="lp-btn lp-btn-primary">Explore Courses</a>
          <% } %>
          <a href="/compiler" class="lp-btn lp-btn-outline">Online Compiler</a>
        </div>
      </div>

      <!-- OUR COLLABORATIONS -->
      <div class="lp-collab">
        <h3>Our Collaborations</h3>
        <div class="lp-collab-logos">
          <a href="https://www.google.com/" target="_blank" rel="noopener noreferrer" title="Google" class="hover:opacity-80 transition">
            <img src="/logo/google.png" alt="Google" />
          </a>
          <a href="https://www.microsoft.com/" target="_blank" rel="noopener noreferrer" title="Microsoft" class="hover:opacity-80 transition">
            <img src="/logo/microsoft.png" alt="Microsoft" />
          </a>
          <a href="https://www.amazon.com/" target="_blank" rel="noopener noreferrer" title="Amazon" class="hover:opacity-80 transition">
            <img src="/logo/amazon.png" alt="Amazon" />
          </a>
          <a href="https://about.meta.com/" target="_blank" rel="noopener noreferrer" title="Meta" class="hover:opacity-80 transition">
            <img src="/logo/meta.png" alt="Meta" />
          </a>
          <a href="https://www.coursera.org/" target="_blank" rel="noopener noreferrer" title="Coursera" class="hover:opacity-80 transition">
            <img src="/logo/coursera.png" alt="Coursera" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       APP SECTION
       ============================================================ -->
  <section class="lp-app">
    <div class="lp-app-card">
      <div class="lp-app-text">
        <h2>Introducing<br><span class="lp-hl">Zero to Pro</span><br>Learning App</h2>
        <p>
          The Zero to Pro Learning app is here! Coding fundamentals as a game. Bite-sized lessons, streaks and XP. Free on iOS and Android.
        </p>
        <div class="lp-store-btns">
          <a href="https://play.google.com/store/apps" target="_blank" rel="noopener noreferrer" class="lp-store-btn" title="Get it on Google Play">
            <img src="/logo/playstore-cropped.png" alt="Google Play" />
          </a>
          <a href="https://apps.apple.com/us/genre/ios/id36" target="_blank" rel="noopener noreferrer" class="lp-store-btn" title="Download on the App Store">
            <img src="/logo/appstore-cropped.png" alt="App Store" />
          </a>
        </div>
      </div>

      <!-- Phone Mockup (unchanged) -->
      <div class="flex-1 flex justify-center">
        <div class="phone-mockup rounded-[2.5rem] w-64 h-[28rem] border-4 border-gray-700 p-3 relative overflow-hidden shadow-2xl shadow-indigo-500/10">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-gray-900 rounded-b-2xl z-10"></div>
          <div class="bg-gray-900 rounded-[2rem] h-full flex flex-col items-center justify-center p-6 text-center">
            <div class="text-4xl mb-3">👨‍💻</div>
            <div class="text-lg font-bold text-white mb-2">Zero to Pro</div>
            <div class="text-xs text-gray-400 mb-6">Learn. Code. Build.</div>
            <div class="grid grid-cols-2 gap-2 w-full">
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-emerald-400 text-lg">⚡</div>
                <div class="text-[10px] text-gray-400">Compiler</div>
              </div>
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-blue-400 text-lg">📝</div>
                <div class="text-[10px] text-gray-400">Quizzes</div>
              </div>
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-purple-400 text-lg">📚</div>
                <div class="text-[10px] text-gray-400">Tutorials</div>
              </div>
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-amber-400 text-lg">🏆</div>
                <div class="text-[10px] text-gray-400">Badges</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TUTORIALS SECTION
       ============================================================ -->
  <section class="lp-tutorials">
    <div class="max-w-4xl mx-auto px-6">
      <span class="lp-eyebrow">TUTORIALS</span>
      <h2>What's The Goal Today?</h2>
      <p>
        Pick a language and start right away. Every tutorial is packed with examples you can run and edit in your browser.
      </p>

      <!-- Language Icon Carousel -->
      <div class="lp-icon-carousel">
        <button class="lp-arrow" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
        <button class="lp-lang-circle active" data-lang="html"><img src="/logo/html5.png" alt="HTML5" /></button>
        <button class="lp-lang-circle" data-lang="css"><img src="/logo/css3.png" alt="CSS3" /></button>
        <button class="lp-lang-circle" data-lang="java"><img src="/logo/java.png" alt="Java" /></button>
        <button class="lp-lang-circle" data-lang="javascript"><img src="/logo/javascript.png" alt="JavaScript" /></button>
        <button class="lp-lang-circle" data-lang="php"><img src="/logo/php.png" alt="PHP" /></button>
        <button class="lp-lang-circle" data-lang="cpp"><img src="/logo/cpp.png" alt="C++" /></button>
        <button class="lp-lang-circle" data-lang="react"><img src="/logo/react.png" alt="React" /></button>
        <button class="lp-lang-circle" data-lang="bootstrap"><img src="/logo/bootstrap.png" alt="Bootstrap" /></button>
        <button class="lp-arrow" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
      </div>

      <!-- Code Editor Preview -->
      <div class="lp-code-wrap">
        <div class="code-editor-header flex items-center gap-2 px-4 py-3 border-b border-gray-700">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="ml-3 text-sm text-gray-400" id="editorLangLabel">HTML Example</span>
        </div>
        <div class="code-editor-body p-5 text-left text-sm leading-relaxed overflow-x-auto" id="codePreview">
          <pre class="text-gray-300"><span class="text-pink-400">&lt;!DOCTYPE html&gt;</span>
<span class="text-pink-400">&lt;html&gt;</span>
  <span class="text-pink-400">&lt;head&gt;</span>
    <span class="text-pink-400">&lt;title&gt;</span><span class="text-emerald-400">HTML Tutorial</span><span class="text-pink-400">&lt;/title&gt;</span>
  <span class="text-pink-400">&lt;/head&gt;</span>
  <span class="text-pink-400">&lt;body&gt;</span>
    <span class="text-pink-400">&lt;h1&gt;</span><span class="text-emerald-400">This is a heading</span><span class="text-pink-400">&lt;/h1&gt;</span>
    <span class="text-pink-400">&lt;p&gt;</span><span class="text-emerald-400">This is a paragraph.</span><span class="text-pink-400">&lt;/p&gt;</span>
  <span class="text-pink-400">&lt;/body&gt;</span>
<span class="text-pink-400">&lt;/html&gt;</span></pre>
        </div>
      </div>

      <a href="/compiler" class="lp-btn lp-btn-primary">Give It A Try →</a>
    </div>
  </section>

  <!-- ============================================================
       LANGUAGES WE OFFER
       ============================================================ -->
  <section class="lp-langs">
    <div class="max-w-5xl mx-auto px-6">
      <span class="lp-eyebrow">ALL LANGUAGES</span>
      <h2>Languages We Offer</h2>
      <p>
        We offer a large variety of programming languages of all types. Feel free to select the language you want to master.
      </p>
      <div class="lp-lang-cards">
        <a href="/tutorials" class="lp-lang-card"><img src="/logo/html5.png" alt="HTML5" /></a>
        <a href="/tutorials" class="lp-lang-card"><img src="/logo/css3.png" alt="CSS3" /></a>
        <a href="/tutorials" class="lp-lang-card"><img src="/logo/java.png" alt="Java" /></a>
        <a href="/tutorials" class="lp-lang-card"><img src="/logo/javascript.png" alt="JavaScript" /></a>
        <a href="/tutorials" class="lp-lang-card"><img src="/logo/php.png" alt="PHP" /></a>
