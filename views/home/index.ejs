          <p>Create your free account and pick up where you left off, anywhere.</p>
          <a href="/login" class="lp-btn-full lp-btn-signin no-underline">Sign In</a>
          <div class="lp-divider-or">OR</div>
          <a href="/signup" class="lp-btn-full lp-btn-signup no-underline" style="color:#fff;">Sign Up</a>
