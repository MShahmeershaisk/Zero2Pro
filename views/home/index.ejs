<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Zero to Pro - Learn & Practice Coding' }) %>
</head>
<body class="font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <!-- ============================================================
       HERO SECTION + OUR COLLABORATIONS (single box)
       ============================================================ -->
  <section class="hero-gradient hero-section collab-bg text-center px-6 pt-20 pb-24 relative overflow-hidden">
    <!-- Decorative floating elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-20 -left-20 w-60 h-60 bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-3xl mx-auto relative z-10 hero-glass">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight">
        From
        <span class="bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">Zero</span>
        to
        <span class="bg-gradient-to-r from-blue-400 to-indigo-400 bg-clip-text text-transparent">Pro</span>
      </h1>
      <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">
        Master high-demand skills with structured learning paths designed to take you from zero to career-ready.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <% if (user) { %>
          <a href="/tutorials" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-8 py-3 rounded-xl transition shadow-lg shadow-emerald-500/20">Explore Courses</a>
        <% } else { %>
          <a href="/signup" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-8 py-3 rounded-xl transition shadow-lg shadow-emerald-500/20">Explore Courses</a>
        <% } %>
        <a href="/compiler" class="border-2 border-blue-500 text-blue-400 hover:bg-blue-500 hover:text-white font-bold px-8 py-3 rounded-xl transition">Online Compiler</a>
      </div>
    </div>

    <!-- OUR COLLABORATIONS -->
    <div class="max-w-5xl mx-auto text-center relative z-10 mt-24">
      <h2 class="text-2xl md:text-3xl font-bold mb-10">Our Collaborations</h2>
      <div class="flex flex-wrap justify-center items-center gap-10 md:gap-16">
        <a href="https://www.google.com/" target="_blank" rel="noopener noreferrer" title="Google" class="hover:scale-105 transition">
          <img src="/logo/Goolge logo.png" alt="Google" class="h-10 md:h-12 object-contain" />
        </a>
        <a href="https://www.microsoft.com/" target="_blank" rel="noopener noreferrer" title="Microsoft" class="hover:scale-105 transition">
          <img src="/logo/microsoft logo.png" alt="Microsoft" class="h-10 md:h-12 object-contain" />
        </a>
        <a href="https://www.amazon.com/" target="_blank" rel="noopener noreferrer" title="Amazon" class="hover:scale-105 transition">
          <img src="/logo/amazon logo.png" alt="Amazon" class="h-10 md:h-12 object-contain" />
        </a>
        <a href="https://about.meta.com/" target="_blank" rel="noopener noreferrer" title="Meta" class="hover:scale-105 transition">
          <img src="/logo/meta_logo.svg.png" alt="Meta" class="h-10 md:h-12 object-contain" />
        </a>
        <a href="https://www.coursera.org/" target="_blank" rel="noopener noreferrer" title="Coursera" class="hover:scale-105 transition">
          <img src="/logo/coursera logo.png" alt="Coursera" class="h-10 md:h-12 object-contain" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       APP SECTION
       ============================================================ -->
  <section class="app-section py-20 px-6">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <!-- Left: Text + App Store Buttons -->
      <div class="flex-1 text-center lg:text-left">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4 leading-tight">
          Introducing<br>
          <span class="bg-gradient-to-r from-indigo-500 to-blue-500 bg-clip-text text-transparent">Zero to Pro</span><br>
          Learning App
        </h2>
        <p class="text-gray-400 mb-8 max-w-md mx-auto lg:mx-0">
          The Zero to Pro Learning app is here! Coding fundamentals as a game. Bite-sized lessons, streaks and XP. Free on iOS and Android.
        </p>
        <div class="flex flex-wrap justify-center lg:justify-start gap-3">
          <a href="https://play.google.com/store/apps" target="_blank" rel="noopener noreferrer" class="store-badge flex items-center justify-center bg-gray-800 hover:bg-gray-700 border border-gray-600 w-12 h-12 rounded-xl transition" title="Get it on Google Play">
            <img src="/logo/goolge paly logo.png" alt="Google Play" class="h-7 w-7 object-contain" />
          </a>
          <a href="https://apps.apple.com/us/genre/ios/id36" target="_blank" rel="noopener noreferrer" class="store-badge flex items-center justify-center bg-gray-800 hover:bg-gray-700 border border-gray-600 w-12 h-12 rounded-xl transition" title="Download on the App Store">
            <img src="/logo/apple logo.png" alt="App Store" class="apple-logo h-7 w-7 object-contain" />
          </a>
        </div>
      </div>

      <!-- Right: Phone Mockup -->
      <div class="flex-1 flex justify-center">
        <div class="phone-mockup rounded-[2.5rem] w-64 h-[28rem] border-4 border-gray-700 p-3 relative overflow-hidden shadow-2xl shadow-indigo-500/10">
          <!-- Phone notch -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-gray-900 rounded-b-2xl z-10"></div>
          <!-- Phone screen content -->
          <div class="bg-gray-900 rounded-[2rem] h-full flex flex-col items-center justify-center p-6 text-center">
            <div class="text-4xl mb-3">👨‍💻</div>
            <div class="text-lg font-bold text-white mb-2">Zero to Pro</div>
            <div class="text-xs text-gray-400 mb-6">Learn. Code. Build.</div>
            <div class="grid grid-cols-2 gap-2 w-full">
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-emerald-400 text-lg">⚡</div>
                <div class="text-[10px] text-gray-400">Compiler</div>
              </div>
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-blue-400 text-lg">📝</div>
                <div class="text-[10px] text-gray-400">Quizzes</div>
              </div>
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-purple-400 text-lg">📚</div>
                <div class="text-[10px] text-gray-400">Tutorials</div>
              </div>
              <div class="bg-gray-800 rounded-lg p-2 text-center">
                <div class="text-amber-400 text-lg">🏆</div>
                <div class="text-[10px] text-gray-400">Badges</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TUTORIALS SECTION
       ============================================================ -->
  <section class="py-20 px-6 bg-gray-800/30">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-3 block">Tutorials</span>
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">What's The Goal Today?</h2>
      <p class="text-gray-400 mb-10 max-w-xl mx-auto">
        Pick a language and start right away. Every tutorial is packed with examples you can run and edit in your browser.
      </p>

      <!-- Language Icon Carousel -->
      <div class="relative mb-10">
        <div class="overflow-hidden rounded-2xl">
          <div id="langCarousel" class="carousel-track justify-center py-4">
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="html">
              <img src="/logo/HTML5_logo_black logo.png" alt="HTML5" class="w-full h-full object-contain" />
            </button>
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="css">
              <img src="/logo/css.png" alt="CSS" class="w-full h-full object-contain" />
            </button>
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="java">
              <img src="/logo/java.png" alt="Java" class="w-full h-full object-contain" />
            </button>
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="javascript">
              <img src="/logo/JavaScript logo.png" alt="JavaScript" class="w-full h-full object-contain" />
            </button>
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="php">
              <img src="/logo/php.png" alt="PHP" class="w-full h-full object-contain" />
            </button>
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="cpp">
              <img src="/logo/C++ logo.png" alt="C++" class="w-full h-full object-contain" />
            </button>
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="react">
              <img src="/logo/React logo.png" alt="React" class="w-full h-full object-contain" />
            </button>
            <button class="lang-card flex-shrink-0 w-16 h-16 rounded-full bg-gray-800 border-2 border-gray-700 p-2 cursor-pointer transition hover:border-indigo-400" data-lang="bootstrap">
              <img src="/logo/Bootstrap logo.png" alt="Bootstrap" class="w-full h-full object-contain" />
            </button>
          </div>
        </div>
      </div>

      <!-- Code Editor Preview -->
      <div class="bg-gray-800 rounded-2xl border border-gray-700 overflow-hidden max-w-2xl mx-auto mb-8 shadow-xl">
        <div class="code-editor-header flex items-center gap-2 px-4 py-3 border-b border-gray-700">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="ml-3 text-sm text-gray-400" id="editorLangLabel">HTML Example</span>
        </div>
        <div class="code-editor-body p-5 text-left text-sm leading-relaxed overflow-x-auto" id="codePreview">
          <pre class="text-gray-300"><span class="text-pink-400">&lt;!DOCTYPE html&gt;</span>
<span class="text-pink-400">&lt;html&gt;</span>
  <span class="text-pink-400">&lt;head&gt;</span>
    <span class="text-pink-400">&lt;title&gt;</span><span class="text-emerald-400">HTML Tutorial</span><span class="text-pink-400">&lt;/title&gt;</span>
  <span class="text-pink-400">&lt;/head&gt;</span>
  <span class="text-pink-400">&lt;body&gt;</span>
    <span class="text-pink-400">&lt;h1&gt;</span><span class="text-emerald-400">This is a heading</span><span class="text-pink-400">&lt;/h1&gt;</span>
    <span class="text-pink-400">&lt;p&gt;</span><span class="text-emerald-400">This is a paragraph.</span><span class="text-pink-400">&lt;/p&gt;</span>
  <span class="text-pink-400">&lt;/body&gt;</span>
<span class="text-pink-400">&lt;/html&gt;</span></pre>
        </div>
      </div>

      <a href="/compiler" class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-8 py-3 rounded-xl transition shadow-lg shadow-emerald-500/20">
        Give It A Try <span class="text-lg">→</span>
      </a>
    </div>
  </section>

  <!-- ============================================================
       LANGUAGES WE OFFER
       ============================================================ -->
  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-3 block">All Languages</span>
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Languages We Offer</h2>
      <p class="text-gray-400 mb-12 max-w-xl mx-auto">
        We offer a large variety of programming languages of all types. Feel free to select the language you want to master.
      </p>

      <!-- Language Cards Carousel -->
      <div class="relative">
        <button id="langPrev" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-gray-800 border border-gray-600 hover:border-indigo-400 text-gray-400 hover:text-white flex items-center justify-center transition text-lg">‹</button>
        <div class="overflow-hidden mx-12">
          <div id="langCardsTrack" class="flex gap-4 md:gap-6 justify-center transition-transform duration-300">
            <a href="/tutorials" class="lang-card group block flex-shrink-0 w-28 md:w-32">
              <div class="lang-card-inner bg-gray-800 border border-gray-700 rounded-2xl p-5 md:p-6 flex flex-col items-center justify-center aspect-square hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition">
                <img src="/logo/HTML5_logo_black logo.png" alt="HTML5" class="w-12 h-12 md:w-14 md:h-14 object-contain mb-3" />
                <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-400 transition">HTML5</span>
              </div>
            </a>
            <a href="/tutorials" class="lang-card group block flex-shrink-0 w-28 md:w-32">
              <div class="lang-card-inner bg-gray-800 border border-gray-700 rounded-2xl p-5 md:p-6 flex flex-col items-center justify-center aspect-square hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition">
                <img src="/logo/css.png" alt="CSS3" class="w-12 h-12 md:w-14 md:h-14 object-contain mb-3" />
                <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-400 transition">CSS3</span>
              </div>
            </a>
            <a href="/tutorials" class="lang-card group block flex-shrink-0 w-28 md:w-32">
              <div class="lang-card-inner bg-gray-800 border border-gray-700 rounded-2xl p-5 md:p-6 flex flex-col items-center justify-center aspect-square hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition">
                <img src="/logo/java.png" alt="Java" class="w-12 h-12 md:w-14 md:h-14 object-contain mb-3" />
                <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-400 transition">Java</span>
              </div>
            </a>
            <a href="/tutorials" class="lang-card group block flex-shrink-0 w-28 md:w-32">
              <div class="lang-card-inner bg-gray-800 border border-gray-700 rounded-2xl p-5 md:p-6 flex flex-col items-center justify-center aspect-square hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition">
                <img src="/logo/JavaScript logo.png" alt="JavaScript" class="w-12 h-12 md:w-14 md:h-14 object-contain mb-3" />
                <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-400 transition">JavaScript</span>
              </div>
            </a>
            <a href="/tutorials" class="lang-card group block flex-shrink-0 w-28 md:w-32">
              <div class="lang-card-inner bg-gray-800 border border-gray-700 rounded-2xl p-5 md:p-6 flex flex-col items-center justify-center aspect-square hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition">
                <img src="/logo/php.png" alt="PHP" class="w-12 h-12 md:w-14 md:h-14 object-contain mb-3" />
                <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-400 transition">PHP</span>
              </div>
            </a>
            <a href="/tutorials" class="lang-card group block flex-shrink-0 w-28 md:w-32">
              <div class="lang-card-inner bg-gray-800 border border-gray-700 rounded-2xl p-5 md:p-6 flex flex-col items-center justify-center aspect-square hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 transition">
                <img src="/logo/C++ logo.png" alt="C++" class="w-12 h-12 md:w-14 md:h-14 object-contain mb-3" />
                <span class="text-xs font-semibold text-gray-400 group-hover:text-indigo-400 transition">C++</span>
              </div>
            </a>
          </div>
        </div>
        <button id="langNext" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-gray-800 border border-gray-600 hover:border-indigo-400 text-gray-400 hover:text-white flex items-center justify-center transition text-lg">›</button>
      </div>
    </div>
  </section>

  <!-- ============================================================
       STUDY ANYWHERE
       ============================================================ -->
  <section class="study-section py-20 px-6">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <!-- Left: Features -->
      <div class="flex-1 text-center lg:text-left">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4 leading-tight">
          Study anywhere.<br>Never lose your place.
        </h2>
        <p class="text-gray-400 mb-8 max-w-lg mx-auto lg:mx-0">
          Anyone can access our tutorials for free. Create a profile to track your XP, preserve daily streaks, and sync your coding journey between web and mobile.
        </p>
        <div class="grid grid-cols-2 gap-4 max-w-lg mx-auto lg:mx-0">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">Progress tracking</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">XP & streaks</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">Ad-free learning</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">Access to App</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">Challenges</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">Practice problems</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">Leagues</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 text-lg">✓</span>
            <span class="text-gray-300 text-sm">Build & host websites</span>
          </div>
        </div>
      </div>

      <!-- Right: Sign In Card -->
      <div class="flex-1 w-full max-w-md mx-auto lg:mx-0">
        <div class="bg-gray-800 border border-gray-700 rounded-2xl p-8 shadow-xl">
          <h3 class="text-xl font-bold mb-2 text-center">Sign In to Level Up.</h3>
          <p class="text-gray-400 text-sm text-center mb-6">Create your free account and pick up where you left off, anywhere.</p>

          <% if (user) { %>
            <div class="text-center">
              <div class="w-16 h-16 rounded-full bg-indigo-600 flex items-center justify-center text-2xl font-bold mx-auto mb-4">
                <%= user.name.charAt(0).toUpperCase() %>
              </div>
              <p class="text-white font-semibold mb-1">Welcome back, <%= user.name %>!</p>
              <p class="text-gray-400 text-sm mb-4">You're already signed in.</p>
              <a href="/tutorials" class="block w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition text-center">Go to Tutorials</a>
            </div>
          <% } else { %>
            <a href="/login" class="block w-full bg-gray-700 hover:bg-gray-600 text-white font-semibold py-3 rounded-xl transition text-center mb-3">Sign In</a>
            <div class="text-center text-gray-500 text-sm mb-3">or</div>
            <a href="/signup" class="block w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition text-center">Sign Up</a>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CERTIFICATES
       ============================================================ -->
  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <!-- Left: Text + Buttons -->
      <div class="flex-1 text-center lg:text-left">
        <span class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-3 block">Certificates</span>
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4 leading-tight">
          Turn Your<br>
          Knowledge Into<br>
          Certified Expertise
        </h2>
        <p class="text-gray-400 mb-8 max-w-md mx-auto lg:mx-0">
          Stand out in the job market with validated skills and shareable credentials built on a legacy of trusted education.
        </p>
        <div class="flex flex-wrap justify-center lg:justify-start gap-3 mb-6">
          <a href="/test" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition">Get Certified</a>
          <a href="/certificates" class="border border-gray-600 text-gray-300 hover:bg-gray-800 font-semibold px-6 py-3 rounded-xl transition">See All Certificates</a>
        </div>
        <div class="flex items-center gap-2 justify-center lg:justify-start text-emerald-400">
          <span class="text-lg">✓</span>
          <span class="text-sm">Verified credential you can share</span>
        </div>
      </div>

      <!-- Right: Certificate Badge -->
      <div class="flex-1 flex items-center justify-center py-6">
        <div class="w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 rounded-full overflow-hidden flex items-center justify-center bg-transparent mx-auto">
          <img src="/logo/certificate.png" alt="Zero to Pro Certified" class="w-full h-full object-contain" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TEST YOUR SKILLS
       ============================================================ -->
  <section class="py-20 px-6 bg-gray-800/30">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-indigo-400 mb-3 block">Test Your Skills</span>
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Practice with Zero to Pro</h2>
      <p class="text-gray-400 mb-10 max-w-xl mx-auto">
        Exercises, quizzes and a new coding challenge every week.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto">
        <a href="/test" class="border-2 border-indigo-500/40 hover:border-indigo-500 bg-gray-800 hover:bg-indigo-500/10 text-white font-semibold py-4 px-6 rounded-xl transition flex items-center justify-center gap-2">
          <span class="text-lg">📝</span> Exercises
        </a>
        <a href="/test" class="border-2 border-indigo-500/40 hover:border-indigo-500 bg-gray-800 hover:bg-indigo-500/10 text-white font-semibold py-4 px-6 rounded-xl transition flex items-center justify-center gap-2">
          <span class="text-lg">❓</span> Quizzes
        </a>
        <a href="/test" class="border-2 border-indigo-500/40 hover:border-indigo-500 bg-gray-800 hover:bg-indigo-500/10 text-white font-semibold py-4 px-6 rounded-xl transition flex items-center justify-center gap-2">
          <span class="text-lg">📅</span> Weekly Problem
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FOOTER
       ============================================================ -->
  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

  <!-- Language carousel + code preview switching -->
  <script>
    const langCodes = {
      html: {
        label: 'HTML Example',
        code: '<span class="text-pink-400">&lt;!DOCTYPE html&gt;</span>\n<span class="text-pink-400">&lt;html&gt;</span>\n  <span class="text-pink-400">&lt;head&gt;</span>\n    <span class="text-pink-400">&lt;title&gt;</span><span class="text-emerald-400">HTML Tutorial</span><span class="text-pink-400">&lt;/title&gt;</span>\n  <span class="text-pink-400">&lt;/head&gt;</span>\n  <span class="text-pink-400">&lt;body&gt;</span>\n    <span class="text-pink-400">&lt;h1&gt;</span><span class="text-emerald-400">This is a heading</span><span class="text-pink-400">&lt;/h1&gt;</span>\n    <span class="text-pink-400">&lt;p&gt;</span><span class="text-emerald-400">This is a paragraph.</span><span class="text-pink-400">&lt;/p&gt;</span>\n  <span class="text-pink-400">&lt;/body&gt;</span>\n<span class="text-pink-400">&lt;/html&gt;</span>'
      },
      css: {
        label: 'CSS Example',
        code: '<span class="text-pink-400">body</span> {\n  <span class="text-blue-400">background-color</span>: <span class="text-emerald-400">#f0f0f0</span>;\n  <span class="text-blue-400">font-family</span>: <span class="text-emerald-400">Arial, sans-serif</span>;\n  <span class="text-blue-400">margin</span>: <span class="text-emerald-400">0</span>;\n  <span class="text-blue-400">padding</span>: <span class="text-emerald-400">20px</span>;\n}\n\n<span class="text-pink-400">h1</span> {\n  <span class="text-blue-400">color</span>: <span class="text-emerald-400">#333</span>;\n  <span class="text-blue-400">text-align</span>: <span class="text-emerald-400">center</span>;\n}'
      },
      java: {
        label: 'Java Example',
        code: '<span class="text-pink-400">public class</span> <span class="text-blue-400">HelloWorld</span> {\n  <span class="text-pink-400">public static void</span> <span class="text-emerald-400">main</span>(String[] args) {\n    System.out.<span class="text-emerald-400">println</span>(<span class="text-emerald-400">"Hello, World!"</span>);\n  }\n}'
      },
      javascript: {
        label: 'JavaScript Example',
        code: '<span class="text-pink-400">const</span> <span class="text-blue-400">message</span> = <span class="text-emerald-400">"Hello, Zero to Pro!"</span>;\n\n<span class="text-pink-400">function</span> <span class="text-emerald-400">greet</span>(name) {\n  <span class="text-pink-400">return</span> <span class="text-emerald-400">`Welcome, ${</span>name<span class="text-emerald-400">}!`</span>;\n}\n\nconsole.<span class="text-emerald-400">log</span>(<span class="text-emerald-400">greet</span>(message));'
      },
      php: {
        label: 'PHP Example',
        code: '<span class="text-pink-400">&lt;?php</span>\n<span class="text-blue-400">$name</span> = <span class="text-emerald-400">"Zero to Pro"</span>;\n\n<span class="text-pink-400">function</span> <span class="text-emerald-400">sayHello</span>(<span class="text-blue-400">$name</span>) {\n  <span class="text-pink-400">return</span> <span class="text-emerald-400">"Hello, "</span> . <span class="text-blue-400">$name</span> . <span class="text-emerald-400">"!"</span>;\n}\n\n<span class="text-pink-400">echo</span> <span class="text-emerald-400">sayHello</span>(<span class="text-blue-400">$name</span>);'
      },
      cpp: {
        label: 'C++ Example',
        code: '<span class="text-pink-400">#include</span> <span class="text-emerald-400">&lt;iostream&gt;</span>\n\n<span class="text-pink-400">using namespace</span> std;\n\n<span class="text-pink-400">int</span> <span class="text-emerald-400">main</span>() {\n  cout &lt;&lt; <span class="text-emerald-400">"Hello, Zero to Pro!"</span> &lt;&lt; endl;\n  <span class="text-pink-400">return</span> <span class="text-emerald-400">0</span>;\n}'
      },
      react: {
        label: 'React Example',
        code: '<span class="text-pink-400">import</span> React <span class="text-pink-400">from</span> <span class="text-emerald-400">\'react\'</span>;\n\n<span class="text-pink-400">function</span> <span class="text-emerald-400">App</span>() {\n  <span class="text-pink-400">return</span> (\n    &lt;<span class="text-blue-400">div</span> className=<span class="text-emerald-400">"app"</span>&gt;\n      &lt;<span class="text-blue-400">h1</span>&gt;Hello, Zero to Pro!&lt;/<span class="text-blue-400">h1</span>&gt;\n    &lt;/<span class="text-blue-400">div</span>&gt;\n  );\n}'
      },
      bootstrap: {
        label: 'Bootstrap Example',
        code: '<span class="text-pink-400">&lt;div</span> class=<span class="text-emerald-400">"container"</span><span class="text-pink-400">&gt;</span>\n  <span class="text-pink-400">&lt;div</span> class=<span class="text-emerald-400">"row"</span><span class="text-pink-400">&gt;</span>\n    <span class="text-pink-400">&lt;div</span> class=<span class="text-emerald-400">"col-md-6"</span><span class="text-pink-400">&gt;</span>\n      <span class="text-pink-400">&lt;h1&gt;</span>Hello World<span class="text-pink-400">&lt;/h1&gt;</span>\n      <span class="text-pink-400">&lt;button</span> class=<span class="text-emerald-400">"btn btn-primary"</span><span class="text-pink-400">&gt;</span>\n        Click Me\n      <span class="text-pink-400">&lt;/button&gt;</span>\n    <span class="text-pink-400">&lt;/div&gt;</span>\n  <span class="text-pink-400">&lt;/div&gt;</span>\n<span class="text-pink-400">&lt;/div&gt;</span>'
      }
    };

    // Language carousel click handler
    document.querySelectorAll('[data-lang]').forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active state
        document.querySelectorAll('[data-lang]').forEach(b => {
          b.classList.remove('border-indigo-400', 'bg-gray-700');
          b.classList.add('border-gray-700');
        });
        btn.classList.remove('border-gray-700');
        btn.classList.add('border-indigo-400', 'bg-gray-700');

        // Update code preview
        const lang = btn.dataset.lang;
        const data = langCodes[lang];
        if (data) {
          document.getElementById('editorLangLabel').textContent = data.label;
          document.getElementById('codePreview').innerHTML = '<pre class="text-gray-300">' + data.code + '</pre>';
        }
      });
    });

    // Set first language as active by default
    const firstLang = document.querySelector('[data-lang="html"]');
    if (firstLang) {
      firstLang.classList.remove('border-gray-700');
      firstLang.classList.add('border-indigo-400', 'bg-gray-700');
    }

    // Language Cards Carousel (Languages We Offer section)
    const langCardsTrack = document.getElementById('langCardsTrack');
    const langPrevBtn = document.getElementById('langPrev');
    const langNextBtn = document.getElementById('langNext');
    let langCardIndex = 0;
    if (langCardsTrack && langPrevBtn && langNextBtn) {
      const langCardItems = langCardsTrack.children;
      const totalLangCards = langCardItems.length;
      function getVisibleCards() {
        if (window.innerWidth >= 768) return 6;
        if (window.innerWidth >= 640) return 4;
        return 3;
      }
      function updateLangCards() {
        const visible = getVisibleCards();
        langCardIndex = Math.min(langCardIndex, Math.max(0, totalLangCards - visible));
        const cardWidth = langCardItems[0].offsetWidth + 16;
        const offset = langCardIndex * cardWidth;
        langCardsTrack.style.transform = 'translateX(-' + offset + 'px)';
      }
      langPrevBtn.addEventListener('click', () => {
        langCardIndex = Math.max(0, langCardIndex - 1);
        updateLangCards();
      });
      langNextBtn.addEventListener('click', () => {
        const visible = getVisibleCards();
        langCardIndex = Math.min(totalLangCards - visible, langCardIndex + 1);
        updateLangCards();
      });
      window.addEventListener('resize', updateLangCards);
    }

    // Scroll-triggered fade-in animation
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));
  </script>
</body>
</html>
