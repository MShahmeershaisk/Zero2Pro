<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'DevHub - Learn & Practice Coding' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <!-- Hero Section -->
  <header class="container mx-auto px-6 py-16 text-center max-w-4xl flex-1">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-tight">
      Master Coding with <span class="text-indigo-500">Interactive Tools & AI</span>
    </h1>
    <p class="text-lg text-gray-400 mb-8">
      Compile code in real-time, test your programming knowledge with quizzes, manage custom tutorials, and get intelligent AI assistance all in one place.
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <% if (user) { %>
        <a href="/tutorials" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition">Explore Tutorials</a>
      <% } else { %>
        <a href="/signup" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition">Get Started Free</a>
      <% } %>
      <a href="/compiler" class="bg-gray-800 hover:bg-gray-700 text-gray-200 border border-gray-600 font-semibold px-6 py-3 rounded-xl transition">Open Code Compiler</a>
    </div>
  </header>

  <!-- Feature Grid -->
  <main class="container mx-auto px-6 pb-8 grid md:grid-cols-3 gap-8 max-w-5xl">
    <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-md flex flex-col justify-between">
      <div>
        <div class="text-indigo-400 text-3xl mb-4">⚡</div>
        <h3 class="text-xl font-bold mb-2">Live Code Compiler</h3>
        <p class="text-gray-400 text-sm">Write, execute, and debug your code live directly from your browser with a full-featured editor.</p>
      </div>
      <a href="/compiler" class="mt-6 text-indigo-400 hover:underline font-semibold text-sm">Launch Compiler &rarr;</a>
    </div>

    <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-md flex flex-col justify-between">
      <div>
        <div class="text-indigo-400 text-3xl mb-4">📝</div>
        <h3 class="text-xl font-bold mb-2">Quizzes & Tests</h3>
        <p class="text-gray-400 text-sm">Evaluate your understanding across multiple categories with automated tests.</p>
      </div>
      <a href="/test" class="mt-6 text-indigo-400 hover:underline font-semibold text-sm">Take a Test &rarr;</a>
    </div>

    <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 shadow-md flex flex-col justify-between">
      <div>
        <div class="text-indigo-400 text-3xl mb-4">🤖</div>
        <h3 class="text-xl font-bold mb-2">AI Assistant</h3>
        <p class="text-gray-400 text-sm">Get instant code explanations, step-by-step guidance, and debugging help from the AI chat widget.</p>
      </div>
      <span class="mt-6 text-gray-500 font-semibold text-sm">Available via chat widget</span>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
