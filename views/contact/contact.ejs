<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Contact Us - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="flex flex-1 items-center justify-center px-6 py-12">
    <div class="w-full max-w-lg bg-gray-800 border border-gray-700 rounded-2xl shadow-lg p-8">
      <h2 class="text-2xl font-bold mb-2 text-center">Contact Us</h2>
      <p class="text-gray-400 text-sm text-center mb-6">Have an issue or suggestion? We'd love to hear from you.</p>

      <% if (success) { %>
        <p class="mb-4 text-sm text-center bg-green-500/10 border border-green-500/50 text-green-400 rounded-lg py-2 px-4"><%= success %></p>
      <% } %>
      <% if (error) { %>
        <p class="mb-4 text-sm text-center bg-red-500/10 border border-red-500/50 text-red-400 rounded-lg py-2 px-4"><%= error %></p>
      <% } %>

      <form method="POST" action="/contact" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

        <div>
          <label for="name" class="block text-sm font-medium text-gray-300 mb-1">Name *</label>
          <input type="text" name="name" id="name" value="<%= filledName %>" placeholder="Your name" required
            class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Email *</label>
          <input type="email" name="email" id="email" value="<%= filledEmail %>" placeholder="you@gmail.com" required
            class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div>
          <label for="memberId" class="block text-sm font-medium text-gray-300 mb-1">Member ID</label>
          <% if (filledMemberId) { %>
            <input type="text" name="memberId" id="memberId" value="<%= filledMemberId %>" readonly
              class="w-full px-4 py-2.5 bg-gray-700/50 border border-gray-600 rounded-lg text-gray-400 cursor-not-allowed" />
            <p class="text-xs text-gray-500 mt-1">Auto-filled from your account</p>
          <% } else { %>
            <input type="text" name="memberId" id="memberId" placeholder="Optional — paste your Member ID"
              class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <p class="text-xs text-gray-500 mt-1">Login to auto-fill</p>
          <% } %>
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium text-gray-300 mb-1">Subject *</label>
          <select name="subject" id="subject" required
            class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="" disabled selected>Select a subject</option>
            <option value="Password Change">Password Change</option>
            <option value="Email Change">Email Change</option>
            <option value="Username Change">Username Change</option>
            <option value="Account Issue">Account Issue</option>
            <option value="Bug Report">Bug Report</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-300 mb-1">Message *</label>
          <textarea name="message" id="message" rows="5" required
            placeholder="Describe your issue or suggestion in detail..."
            class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-y"></textarea>
        </div>

        <button type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg transition">Send Message</button>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
