<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Tutorials - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <main class="flex-1">
    <!-- Hero -->
    <section class="text-center px-6 py-14 max-w-3xl mx-auto">
      <span class="inline-block text-xs font-semibold uppercase tracking-widest text-indigo-400 mb-3">Zero to Pro Library</span>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Choose a Language</h1>
      <p class="text-gray-400 text-lg">Pick a language to start learning — tutorials, exercises and certificates all in one place.</p>
    </section>

    <!-- Language grid -->
    <div class="max-w-6xl mx-auto px-6 pb-20">
      <% if (languages.length === 0) { %>
        <p class="text-gray-400 text-center py-10">No tutorials available yet. Check back soon!</p>
      <% } else { %>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
          <% languages.forEach(lang => { %>
            <a href="/tutorials/<%= lang.slug %>"
               class="group bg-gray-800 border border-gray-700 rounded-2xl p-6 flex flex-col items-center text-center transition
                      hover:border-indigo-500/60 hover:shadow-xl
                      <%= lang.hasContent ? '' : 'opacity-60 hover:opacity-80' %>">
              <div class="w-20 h-20 md:w-24 md:h-24 rounded-2xl bg-gray-900 border border-gray-700 flex items-center justify-center p-4 mb-4 transition group-hover:scale-105">
                <img src="<%= lang.logo %>" alt="<%= lang.name %> logo" class="w-full h-full object-contain"
                     onerror="this.onerror=null;this.src='/logo/badge.png';" />
              </div>
              <h2 class="text-lg font-bold mb-1"><%= lang.name %></h2>
              <% if (lang.hasContent) { %>
                <span class="text-xs text-gray-500"><%= lang.count %> <%= lang.count === 1 ? 'tutorial' : 'tutorials' %></span>
              <% } else { %>
                <span class="text-xs bg-gray-700/60 text-gray-400 px-2.5 py-1 rounded-full">Coming soon</span>
              <% } %>
            </a>
          <% }) %>
        </div>
        <p class="text-center text-gray-500 text-sm mt-10"><%= total %> tutorial<%= total === 1 ? '' : 's' %> available across all languages</p>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>