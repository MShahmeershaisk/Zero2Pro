<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Compiler - DevHub' }) %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/editor/editor.main.min.css" />
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="container mx-auto max-w-6xl px-6 py-8 flex-1 flex flex-col">
    <div class="flex items-center justify-between flex-wrap gap-4 mb-5">
      <h2 class="text-3xl font-bold">Code Compiler</h2>

      <div class="flex items-center gap-3">
        <label for="langSelect" class="text-gray-300 text-sm font-medium">Language:</label>
        <select id="langSelect"
          class="bg-gray-700 border border-gray-600 rounded-lg text-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="python">Python</option>
          <option value="java">Java</option>
          <option value="javascript">JavaScript</option>
          <option value="html">HTML</option>
        </select>
        <button id="runBtn"
          class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2 rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed">Run Code</button>
        <button id="clearBtn"
          class="bg-gray-700 hover:bg-gray-600 text-white font-semibold px-4 py-2 rounded-lg transition">Clear</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 flex-1">
      <!-- Monaco Editor -->
      <div class="flex flex-col min-h-[400px]">
        <div class="text-xs uppercase tracking-wide text-gray-400 mb-2">Code</div>
        <div id="editor" class="flex-1 rounded-xl overflow-hidden border border-gray-700 min-h-[400px]"></div>
      </div>

      <!-- Output -->
      <div class="flex flex-col min-h-[400px]">
        <div class="text-xs uppercase tracking-wide text-gray-400 mb-2">Output</div>
        <pre id="output" class="flex-1 rounded-xl bg-gray-950 border border-gray-700 text-green-400 p-4 font-mono text-sm overflow-auto min-h-[400px] whitespace-pre-wrap"></pre>
        <iframe id="previewFrame" class="hidden mt-2 w-full rounded-xl border border-gray-700 bg-white" style="height:400px"></iframe>
      </div>
    </div>

    <!-- Custom input box (shown when code reads stdin) -->
    <div id="stdinWrapper" class="mt-5 hidden">
      <label for="stdinInput" class="block text-sm font-medium text-gray-300 mb-1">
        <strong>Input</strong> (one value per line):
      </label>
      <textarea id="stdinInput" rows="3" placeholder="Enter your input"
        class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

  <!-- Monaco Editor loader -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
  <script src="/js/compiler.js?v=7"></script>
</body>
</html>
