<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Reset Password - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="flex flex-1 items-center justify-center px-6 py-12">
    <div class="w-full max-w-md bg-gray-800 border border-gray-700 rounded-2xl shadow-lg p-8">
      <h2 class="text-2xl font-bold mb-2 text-center">Reset Password</h2>
      <p class="text-gray-400 text-sm text-center mb-6">Enter your new password below.</p>

      <% if (error) { %>
        <p class="mb-4 text-sm text-center bg-red-500/10 border border-red-500/50 text-red-400 rounded-lg py-2 px-4"><%= error %></p>
      <% } %>

      <form method="POST" action="/reset-password/<%= token %>" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <p class="text-xs text-gray-500">Password: at least 8 characters with 1 uppercase letter and 1 number</p>
        <div>
          <label for="password" class="block text-sm font-medium text-gray-300 mb-1">New Password</label>
          <input type="password" name="password" id="password" placeholder="At least 8 characters, 1 uppercase, 1 number" required minlength="8"
            class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-300 mb-1">Confirm New Password</label>
          <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Re-enter your password" required minlength="8"
            class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <button type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg transition">Reset Password</button>
      </form>

      <p class="mt-6 text-center text-sm text-gray-400">
        <a href="/login" class="text-indigo-400 hover:underline">Back to Login</a>
      </p>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
