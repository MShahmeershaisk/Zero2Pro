<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Forgot Password - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="flex flex-1 items-center justify-center px-6 py-12">
    <div class="w-full max-w-md bg-gray-800 border border-gray-700 rounded-2xl shadow-lg p-8">
      <h2 class="text-2xl font-bold mb-2 text-center">Forgot Password?</h2>
      <p class="text-gray-400 text-sm text-center mb-6">Enter your email and we'll send you a reset link.</p>

      <% if (error) { %>
        <p class="mb-4 text-sm text-center bg-red-500/10 border border-red-500/50 text-red-400 rounded-lg py-2 px-4"><%= error %></p>
      <% } %>
      <% if (success) { %>
        <p class="mb-4 text-sm text-center bg-green-500/10 border border-green-500/50 text-green-400 rounded-lg py-2 px-4"><%= success %></p>
      <% } %>

      <form method="POST" action="/forgot-password" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <div>
          <label for="email" class="block text-sm font-medium text-gray-300 mb-1">Email Address</label>
          <input type="email" name="email" id="email" placeholder="you@gmail.com" required
            class="w-full px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>
        <button type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg transition">Send Reset Link</button>
      </form>

      <p class="mt-6 text-center text-sm text-gray-400">
        Remember your password? <a href="/login" class="text-indigo-400 hover:underline">Login</a>
      </p>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
