<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Messages - Zero to Pro' }) %>
</head>
<body class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col">

  <%- include('../partials/navbar') %>

  <div class="flex flex-1 max-w-6xl mx-auto w-full px-4 py-6 gap-4" style="height: calc(100vh - 73px);">

    <!-- LEFT: Thread List -->
    <div class="w-full md:w-80 flex-shrink-0 bg-gray-800 border border-gray-700 rounded-2xl flex flex-col overflow-hidden">
      <div class="p-4 border-b border-gray-700 flex items-center justify-between">
        <h2 class="text-lg font-bold">Messages</h2>
        <button id="newMessageBtn" onclick="showNewMessageForm()"
          class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition">
          + New
        </button>
      </div>

      <!-- New Message Form (hidden by default) -->
      <div id="newMessageForm" class="hidden p-4 border-b border-gray-700 bg-gray-750">
        <select id="newSubject" class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white mb-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="" disabled selected>Select subject</option>
          <option value="Password Change">Password Change</option>
          <option value="Email Change">Email Change</option>
          <option value="Username Change">Username Change</option>
          <option value="Account Issue">Account Issue</option>
          <option value="Bug Report">Bug Report</option>
          <option value="Other">Other</option>
        </select>
        <textarea id="newMessageText" rows="3" placeholder="Type your message..."
          class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white placeholder-gray-400 resize-none focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
        <div class="flex gap-2 mt-2">
          <button id="sendNewMsgBtn" onclick="submitNewMessage()" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold py-2 rounded-lg transition">Send</button>
          <button onclick="hideNewMessageForm()" class="px-3 py-2 bg-gray-700 hover:bg-gray-600 text-gray-300 text-sm rounded-lg transition">Cancel</button>
        </div>
      </div>

      <!-- Thread List -->
      <div id="threadList" class="flex-1 overflow-y-auto">
        <% if (messages.length === 0) { %>
          <div class="p-6 text-center text-gray-500">
            <p class="text-sm">No messages yet.</p>
            <a href="/contact" class="text-indigo-400 hover:underline text-sm mt-2 inline-block">Contact Us</a>
          </div>
        <% } else { %>
          <% messages.forEach((m, i) => { %>
            <div class="thread-item p-4 border-b border-gray-700 cursor-pointer hover:bg-gray-750 transition <%= i === 0 ? 'bg-gray-750' : '' %>"
              data-id="<%= m._id %>" onclick="loadConversation('<%= m._id %>')">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-semibold text-white truncate"><%= m.subject %></span>
                <span class="inline-block text-[10px] px-1.5 py-0.5 rounded-full
                  <%= m.status === 'pending' ? 'bg-yellow-500/20 text-yellow-300' :
                       m.status === 'read' ? 'bg-blue-500/20 text-blue-300' :
                       'bg-green-500/20 text-green-300' %>"><%= m.status %></span>
              </div>
              <% if (user && user.role === 'admin') { %>
                <p class="text-[11px] text-indigo-400 truncate"><%= m.name %> &lt;<%= m.email %>&gt;</p>
              <% } %>
              <p class="text-xs text-gray-400 truncate"><%= m.message %></p>
              <div class="flex items-center justify-between mt-1">
                <span class="text-[10px] text-gray-500"><%= m.createdAt ? new Date(m.createdAt).toLocaleDateString() : '' %></span>
                <% if (m.replies && m.replies.length > 0) { %>
                  <span class="text-[10px] text-gray-500"><%= m.replies.length %> repl<%= m.replies.length === 1 ? 'y' : 'ies' %></span>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- RIGHT: Conversation View -->
    <div class="hidden md:flex flex-col flex-1 bg-gray-800 border border-gray-700 rounded-2xl overflow-hidden">
      <!-- Empty state -->
      <div id="emptyState" class="flex-1 flex items-center justify-center text-gray-500">
        <div class="text-center">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          <p>Select a conversation to view</p>
        </div>
      </div>

      <!-- Conversation Header -->
      <div id="convHeader" class="hidden p-4 border-b border-gray-700 flex items-center justify-between">
        <div>
          <h3 id="convSubject" class="font-bold text-white"></h3>
          <p id="convUser" class="text-[11px] text-indigo-400 hidden"></p>
          <p id="convDate" class="text-xs text-gray-500"></p>
        </div>
        <span id="convStatus" class="text-[10px] px-2 py-0.5 rounded-full"></span>
      </div>

      <!-- Messages Area -->
      <div id="convMessages" class="hidden flex-1 overflow-y-auto p-4 space-y-4"></div>

      <!-- Reply Input -->
      <div id="replyArea" class="hidden p-4 border-t border-gray-700">
        <form id="replyForm" onsubmit="submitReply(event)" class="flex gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" id="replyMsgId" value="" />
          <input type="text" id="replyInput" placeholder="Type your reply..."
            class="flex-1 px-4 py-2.5 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          <button id="sendReplyBtn" type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition">Send</button>
        </form>
      </div>
    </div>
  </div>

  <!-- CSRF token for JS -->
  <script>
    const CSRF_TOKEN = '<%= csrfToken %>';
    const CURRENT_USER = '<%= user ? user.name : "" %>';
    const CURRENT_USER_EMAIL = '<%= user ? user.email : "" %>';
    const CURRENT_USER_ROLE = '<%= user ? user.role : "" %>';

    // Show/hide new message form
    function showNewMessageForm() {
      document.getElementById('newMessageForm').classList.remove('hidden');
      document.getElementById('newMessageText').focus();
    }
    function hideNewMessageForm() {
      document.getElementById('newMessageForm').classList.add('hidden');
      document.getElementById('newSubject').selectedIndex = 0;
      document.getElementById('newMessageText').value = '';
    }

    // Submit new message
    async function submitNewMessage() {
      const subject = document.getElementById('newSubject').value;
      const message = document.getElementById('newMessageText').value.trim();
      if (!subject) return alert('Please select a subject.');
      if (!message) return alert('Please enter a message.');

      const btn = document.getElementById('sendNewMsgBtn');
      btn.disabled = true;
      const origText = btn.textContent;
      btn.textContent = 'Sending...';

      try {
        const res = await fetch('/api/chat/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
          body: JSON.stringify({ subject, message }),
        });
        const data = await res.json();
        if (data.success) {
          hideNewMessageForm();
          // Reload page to show new thread
          window.location.reload();
        } else {
          alert(data.message || 'Failed to send message.');
        }
      } catch (err) {
        alert('Something went wrong. Please try again.');
      } finally {
        btn.disabled = false;
        btn.textContent = origText;
      }
    }

    // Load conversation when clicking a thread
    async function loadConversation(msgId) {
      // Highlight selected thread
      document.querySelectorAll('.thread-item').forEach(el => el.classList.remove('bg-gray-750'));
      const selected = document.querySelector(`.thread-item[data-id="${msgId}"]`);
      if (selected) selected.classList.add('bg-gray-750');

      try {
        const res = await fetch(`/api/chat/conversation/${msgId}`);
        const data = await res.json();
        if (!data.success) return alert(data.message);

        const msg = data.message;

        // Show conversation
        document.getElementById('emptyState').classList.add('hidden');
        document.getElementById('convHeader').classList.remove('hidden');
        document.getElementById('convMessages').classList.remove('hidden');
        document.getElementById('replyArea').classList.remove('hidden');

        // Header
        document.getElementById('convSubject').textContent = msg.subject;
        document.getElementById('convDate').textContent = new Date(msg.createdAt).toLocaleString();
        // Show user info for admin
        const convUser = document.getElementById('convUser');
        if (CURRENT_USER_ROLE === 'admin') {
          convUser.classList.remove('hidden');
          convUser.textContent = msg.name + ' <' + msg.email + '>' + (msg.memberId ? ' · ID: ' + msg.memberId.slice(0, 8) : '');
        } else {
          convUser.classList.add('hidden');
        }
        const statusEl = document.getElementById('convStatus');
        statusEl.textContent = msg.status;
        statusEl.className = 'text-[10px] px-2 py-0.5 rounded-full ' +
          (msg.status === 'pending' ? 'bg-yellow-500/20 text-yellow-300' :
           msg.status === 'read' ? 'bg-blue-500/20 text-blue-300' :
           'bg-green-500/20 text-green-300');

        document.getElementById('replyMsgId').value = msg._id;

        // Build messages
        const container = document.getElementById('convMessages');
        container.innerHTML = '';

        // Original message (user, right-aligned)
        container.innerHTML += `
          <div class="flex justify-end">
            <div class="max-w-[75%] bg-indigo-600 text-white rounded-2xl rounded-br-md px-4 py-3">
              <p class="text-sm">${escapeHtml(msg.message)}</p>
              <p class="text-[10px] text-indigo-200 mt-1 text-right">${formatTime(msg.createdAt)}</p>
            </div>
          </div>`;

        // Replies
        (msg.replies || []).forEach(r => {
          const isAdmin = r.sender === 'admin';
          container.innerHTML += `
            <div class="flex ${isAdmin ? 'justify-start' : 'justify-end'}">
              <div class="max-w-[75%] ${isAdmin ? 'bg-gray-700 text-gray-100 rounded-2xl rounded-bl-md' : 'bg-indigo-600 text-white rounded-2xl rounded-br-md'} px-4 py-3">
                ${isAdmin ? `<p class="text-[10px] text-indigo-400 font-semibold mb-1">${escapeHtml(r.senderName || 'Admin')}</p>` : ''}
                <p class="text-sm">${escapeHtml(r.message)}</p>
                <p class="text-[10px] ${isAdmin ? 'text-gray-400' : 'text-indigo-200'} mt-1 ${isAdmin ? '' : 'text-right'}">${formatTime(r.createdAt)}</p>
              </div>
            </div>`;
        });

        // Scroll to bottom
        container.scrollTop = container.scrollHeight;
      } catch (err) {
        alert('Failed to load conversation.');
      }
    }

    // Submit reply
    async function submitReply(e) {
      e.preventDefault();
      const msgId = document.getElementById('replyMsgId').value;
      const input = document.getElementById('replyInput');
      const message = input.value.trim();
      if (!message) return;

      const btn = document.getElementById('sendReplyBtn');
      btn.disabled = true;
      const origText = btn.textContent;
      btn.textContent = 'Sending...';

      try {
        const res = await fetch(`/api/chat/reply/${msgId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
          body: JSON.stringify({ message }),
        });
        const data = await res.json();
        if (data.success) {
          input.value = '';
          // Reload conversation
          loadConversation(msgId);
        } else {
          alert(data.message || 'Failed to send reply.');
        }
      } catch (err) {
        alert('Something went wrong. Please try again.');
      } finally {
        btn.disabled = false;
        btn.textContent = origText;
      }
    }

    // Helpers
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
    function formatTime(dateStr) {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      const now = new Date();
      const diffMs = now - d;
      const diffMin = Math.floor(diffMs / 60000);
      if (diffMin < 1) return 'Just now';
      if (diffMin < 60) return diffMin + 'm ago';
      const diffHr = Math.floor(diffMin / 60);
      if (diffHr < 24) return diffHr + 'h ago';
      return d.toLocaleDateString();
    }

    // Auto-load first thread on page load
    document.addEventListener('DOMContentLoaded', () => {
      const first = document.querySelector('.thread-item');
      if (first) loadConversation(first.dataset.id);
    });
  </script>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
